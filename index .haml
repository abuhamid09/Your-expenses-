function deltaBadge(cur, prev, increaseIsBad) {
  if (prev <= 0) return `<span class="delta flat">لا مقارنة</span>`;
  const p = ((cur - prev) / prev) * 100, up = p >= 0;
  const good = increaseIsBad ? !up : up;
  return `<span class="delta ${good ? 'good' : 'bad'}">${up ? '▲' : '▼'} ${fmtNumber(Math.abs(Math.round(p)))}%</span>`;
}

const kpiCard = (title, val, badge, sub) =>
  `<div class="card kpi-card"><h4>${title}</h4><div class="kpi-val">${val}</div>${badge || ''}<div class="kpi-sub">${sub}</div></div>`;

function buildTips(tc, tp, expNow, totalExp) {
  const tips = [];
  if (tc.income === 0 && tc.expense === 0)
    tips.push({ t:'info', x:'لا بيانات لهذا الشهر بعد — ابدأ بإضافة معاملاتكما من زر «إضافة».' });
  if (tc.income > 0 && tc.expense > tc.income)
    tips.push({ t:'danger', x:`المصروفات تجاوزت الدخل بمقدار <b>${fmtMoney(tc.expense - tc.income)}</b> هذا الشهر — راجعا الفئات الكبرى أدناه.` });
  const largest = Object.entries(expNow).sort((a, b) => b[1] - a[1])[0];
  if (largest && totalExp > 0 && largest[1] / totalExp > 0.3) {
    const c = categoryById('expense', largest[0]);
    tips.push({ t:'warn', x:`فئة «${c.label} ${c.icon}» وحدها تستهلك <b>${fmtNumber(Math.round(largest[1] / totalExp * 100))}%</b> من مصروف الشهر — جرّبا وضع سقف أسبوعي لها.` });
  }
  if (tp.expense > 0 && tc.expense > tp.expense * 1.25)
    tips.push({ t:'warn', x:`المصروف ارتفع <b>${fmtNumber(Math.round((tc.expense - tp.expense) / tp.expense * 100))}%</b> مقارنة بالشهر الماضي.` });
  const rate = Stats.savingsRate(tc);
  if (tc.income > 0 && rate >= 20)
    tips.push({ t:'good', x:`معدل ادخار ممتاز (<b>${fmtNumber(Math.round(rate))}%</b>) — فكّرا بتوجيه الفائض لأحد أهداف الادخار.` });
  else if (tc.income > 0 && rate > 0 && rate < 10)
    tips.push({ t:'info', x:'معدل الادخار أقل من 10% — حتى مبلغ صغير ثابت شهريًا يصنع فرقًا كبيرًا مع الوقت.' });
  for (const g of state.goals) {
    const s = goalStats(g);
    if (s.daysLeft >= 0 && s.remaining > 0 && s.pace < s.requiredMonthly * 0.7)
      tips.push({ t:'warn', x:`وتيرة الادخار الحالية لهدف «${escapeHtml(g.name)}» أبطأ من المطلوب — يلزمكما نحو <b>${fmtMoney(s.requiredMonthly)}</b> شهريًا للوصول في الموعد.` });
    if (s.pct >= 100) tips.push({ t:'good', x:`🎉 اكتمل هدف «${escapeHtml(g.name)}» — مبروك!` });
  }
  if (!tips.length) tips.push({ t:'info', x:'أضفا المزيد من المعاملات ليقدّم لكما التطبيق نصائح مخصصة.' });
  return tips;
}

function renderAnalytics() {
  const mkNow = currentMonthKey();
  const keys = Stats.lastMonthKeys(CONFIG.monthsWindow);
  const mkPrev = keys.length > 1 ? keys[keys.length - 2] : mkNow;
  const cur = Stats.inMonth(state.transactions, mkNow);
  const prev = Stats.inMonth(state.transactions, mkPrev);
  const tc = Stats.totals(cur), tp = Stats.totals(prev);
  $('#analyticsTitle').innerHTML = '';
  $('#analyticsTitle').append(`التحليلات والإحصائيات — ${monthLabel(mkNow, true)}`);
  const dayOfMonth = new Date().getDate();
  const avgDaily = tc.expense / dayOfMonth;
  const forecast = avgDaily * daysInMonthOf(mkNow);
  const rate = Stats.savingsRate(tc);
  $('#kpiGrid').innerHTML =
    kpiCard('الدخل هذا الشهر', fmtMoney(tc.income), deltaBadge(tc.income, tp.income, false), 'عن الشهر الماضي') +
    kpiCard('المصروف هذا الشهر', fmtMoney(tc.expense), deltaBadge(tc.expense, tp.expense, true), 'عن الشهر الماضي') +
    kpiCard('متوسط الإنفاق اليومي', fmtMoney(avgDaily), '', `على مدى ${fmtNumber(dayOfMonth)} يومًا`) +
    kpiCard('توقع مصروف نهاية الشهر', fmtMoney(forecast), '', 'حسب وتيرتكما الحالية') +
    kpiCard('نسبة الادخار', fmtNumber(Math.round(rate)) + '%', '', rate >= 0 ? 'من دخل هذا الشهر' : 'تجاوز في المصروف');
  const expNow = Stats.byCategory(cur, 'expense'), expPrev = Stats.byCategory(prev, 'expense');
  const totalExp = tc.expense;
  const habits = [];
  const largest = Object.entries(expNow).sort((a, b) => b[1] - a[1])[0];
  if (largest) {
    const c = categoryById('expense', largest[0]);
    habits.push({ icon: c.icon, title: 'أكبر فئة إنفاق هذا الشهر', text: `${c.label} — ${fmtMoney(largest[1])} (${fmtNumber(Math.round(largest[1] / totalExp * 100))}% من المصروف)` });
  }
  let bestRise = null;
  for (const id of new Set([...Object.keys(expNow), ...Object.keys(expPrev)])) {
    const diff = (expNow[id] || 0) - (expPrev[id] || 0);
    if (diff > 0 && (!bestRise || diff > bestRise.diff)) bestRise = { id, diff };
  }
  if (bestRise) {
    const c = categoryById('expense', bestRise.id);
    habits.push({ icon: '📈', title: 'أكثر فئة زاد إنفاقها عن الشهر الماضي', text: `${c.label} ${c.icon} — زيادة ${fmtMoney(bestRise.diff)}` });
  }
  const incNow = Stats.byCategory(cur, 'income');
  const topInc = Object.entries(incNow).sort((a, b) => b[1] - a[1])[0];
  if (topInc) {
    const c = categoryById('income', topInc[0]);
    habits.push({ icon: '💰', title: 'أعلى مصدر دخل هذا الشهر', text: `${c.label} ${c.icon} — ${fmtMoney(topInc[1])}` });
  }
  $('#habitsGrid').innerHTML = habits.length
    ? habits.map(h => `<div class="card habit-card"><span class="habit-icon">${h.icon}</span>
        <div><h4>${h.title}</h4><p>${h.text}</p></div></div>`).join('')
    : `<div class="card hint">لا توجد بيانات كافية بعد لهذا الشهر.</div>`;
  const icons = { danger: 'alert', warn: 'alert', good: 'check', info: 'spark' };
  $('#tipsList').innerHTML = buildTips(tc, tp, expNow, totalExp)
    .map(t => `<li class="tip ${t.t}"><svg class="ic"><use href="#i-${icons[t.t]}"/></svg><div>${t.x}</div></li>`).join('');
  Charts.renderAll();
}

const Charts = {
  reg: {},
  cssVar(v) { return getComputedStyle(document.documentElement).getPropertyValue(v).trim(); },
  make(id, cfg) { const cv = document.getElementById(id); if (!cv) return; if (this.reg[id]) this.reg[id].destroy(); this.reg[id] = new Chart(cv, cfg); },
  noData(id) { const cv = document.getElementById(id); if (cv) cv.parentNode.innerHTML = '<div class="no-data">لا توجد بيانات كافية بعد 🌱</div>'; },
  axes() {
    return { x: { ticks: { color: this.cssVar('--muted'), font: { size: 10 } }, grid: { display: false } },
             y: { ticks: { color: this.cssVar('--muted'), font: { size: 10 } }, grid: { color: this.cssVar('--chart-grid') }, beginAtZero: true } };
  },
  legend() { return { rtl: true, labels: { color: this.cssVar('--muted'), usePointStyle: true, pointStyle: 'circle', font: { family: "'Tajawal'", size: 11 } } }; },
  moneyTip() {
    return { rtl: true, titleFont: { family: "'Tajawal'" }, bodyFont: { family: "'Tajawal'" },
      callbacks: { label: c => ` ${c.dataset.label}: ${fmtMoney(c.parsed.y ?? c.parsed)}` } };
  },
  renderAll() {
    if (!window.Chart) { $$('.chart-box').forEach(b => b.innerHTML = '<div class="no-data">يتطلب الرسم مكتبة Chart.js (غير متوفرة دون اتصال)</div>'); return; }
    const txs = state.transactions;
    const keys = Stats.lastMonthKeys(CONFIG.monthsWindow);
    const labels = keys.map(k => monthLabel(k));
    const mkNow = currentMonthKey();
    this.make('chartTrend', { type: 'line',
      data: { labels, datasets: [
        { label: 'الدخل', data: keys.map(k => Stats.totals(Stats.inMonth(txs, k)).income), borderColor: '#2fbf9a', backgroundColor: 'rgba(47,191,154,.14)', fill: true, tension: .38, borderWidth: 2.5, pointRadius: 3 },
        { label: 'المصروف', data: keys.map(k => Stats.totals(Stats.inMonth(txs, k)).expense), borderColor: '#e2708f', backgroundColor: 'rgba(226,112,143,.12)', fill: true, tension: .38, borderWidth: 2.5, pointRadius: 3 } ] },
      options: { responsive: true, maintainAspectRatio: false, plugins: { legend: this.legend(), tooltip: this.moneyTip() }, scales: this.axes() } });
    this.make('chartPersonIncome', { type: 'bar',
      data: { labels, datasets: state.people.map((p, i) => ({ label: p.name, data: keys.map(k => Stats.totals(Stats.inMonth(Stats.ofPerson(txs, p.id), k)).income), backgroundColor: i === 0 ? '#0e6d5a' : '#e2b457', borderRadius: 7, maxBarThickness: 26 })) },
      options: { responsive: true, maintainAspectRatio: false, plugins: { legend: this.legend(), tooltip: this.moneyTip() }, scales: this.axes() } });
    const exp = Object.entries(Stats.byCategory(Stats.inMonth(txs, mkNow), 'expense'));
    if (!exp.length) this.noData('chartExpenseCats');
    else this.make('chartExpenseCats', { type: 'doughnut',
      data: { labels: exp.map(([id]) => categoryById('expense', id).label), datasets: [{ data: exp.map(([, v]) => v), backgroundColor: exp.map(([id]) => categoryById('expense', id).color), borderWidth: 2, borderColor: this.cssVar('--surface') }] },
      options: { responsive: true, maintainAspectRatio: false, cutout: '60%', plugins: { legend: { ...this.legend(), position: 'bottom' }, tooltip: { rtl: true, callbacks: { label: c => ` ${c.label}: ${fmtMoney(c.parsed)}` } } } } });
    const inc = Object.entries(Stats.byCategory(Stats.inMonth(txs, mkNow), 'income'));
    if (!inc.length) this.noData('chartIncomeCats');
    else this.make('chartIncomeCats', { type: 'doughnut',
      data: { labels: inc.map(([id]) => categoryById('income', id).label), datasets: [{ data: inc.map(([, v]) => v), backgroundColor: inc.map(([id]) => categoryById('income', id).color), borderWidth: 2, borderColor: this.cssVar('--surface') }] },
      options: { responsive: true, maintainAspectRatio: false, cutout: '60%', plugins: { legend: { ...this.legend(), position: 'bottom' }, tooltip: { rtl: true, callbacks: { label: c => ` ${c.label}: ${fmtMoney(c.parsed)}` } } } } });
    const dim = daysInMonthOf(mkNow);
    const dayIn = Array(dim).fill(0), dayOut = Array(dim).fill(0);
    for (const t of Stats.inMonth(txs, mkNow)) {
      const d = +t.date.slice(8) - 1;
      t.type === 'income' ? dayIn[d] += t.amount : dayOut[d] += t.amount;
    }
    this.make('chartDaily', { type: 'bar',
      data: { labels: Array.from({ length: dim }, (_, i) => fmtNumber(i + 1)), datasets: [
        { label: 'دخل', data: dayIn, backgroundColor: 'rgba(47,191,154,.85)', borderRadius: 4, maxBarThickness: 12 },
        { label: 'مصروف', data: dayOut, backgroundColor: 'rgba(226,112,143,.85)', borderRadius: 4, maxBarThickness: 12 } ] },
      options: { responsive: true, maintainAspectRatio: false, plugins: { legend: this.legend(), tooltip: this.moneyTip() }, scales: { x: { ticks: { color: this.cssVar('--muted'), font: { size: 10 }, maxTicksLimit: 12 }, grid: { display: false } }, y: { ticks: { color: this.cssVar('--muted'), font: { size: 10 } }, grid: { color: this.cssVar('--chart-grid') }, beginAtZero: true } } } });
    const rates = keys.map(k => Math.round(Stats.savingsRate(Stats.totals(Stats.inMonth(txs, k)))));
    this.make('chartSavings', { type: 'bar',
      data: { labels, datasets: [{ label: 'معدل الادخار %', data: rates, borderRadius: 8, maxBarThickness: 30, backgroundColor: rates.map(r => r >= 0 ? 'rgba(47,191,154,.85)' : 'rgba(226,112,143,.9)') }] },
      options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false }, tooltip: { rtl: true, callbacks: { label: c => ` ${fmtNumber(c.parsed.y)}%` } } }, scales: this.axes() } });
  }
};

