function goalStats(g) {
  const p1 = state.people[0], p2 = state.people[1];
  const profitPid = getProfitPid();
  let per1, per2, paceStart;
  if (g.auto) {
    const start = g.autoStart || g.createdAt || todayISO();
    const txs = state.transactions.filter(t => t.date >= start);
    const n1 = Stats.totals(Stats.ofPerson(txs, p1.id)).net;
    const n2 = Stats.totals(Stats.ofPerson(txs, p2.id)).net;
    per1 = (profitPid !== 0 && p1.id === profitPid) ? n1 * CONFIG.partnerProfitRate : n1;
    per2 = (profitPid !== 0 && p2.id === profitPid) ? n2 * CONFIG.partnerProfitRate : n2;
    paceStart = start;
  } else {
    const cs = g.contributions || [];
    per1 = cs.filter(c => c.personId === p1.id).reduce((a, c) => a + c.amount, 0);
    per2 = cs.filter(c => c.personId === p2.id).reduce((a, c) => a + c.amount, 0);
    per1 += cs.filter(c => !c.personId).reduce((a, c) => a + c.amount, 0);
    paceStart = g.createdAt || todayISO();
  }
  const saved = (g.initialSaved || 0) + per1 + per2;
  const pct = g.targetAmount > 0 ? Math.max(0, Math.min(100, (saved / g.targetAmount) * 100)) : 0;
  const remaining = Math.max(0, g.targetAmount - saved);
  const daysLeft = Math.max(0, Math.ceil((parseISO(g.dueDate) - new Date()) / 86400000));
  const monthsLeft = Math.max(0, Math.ceil(daysLeft / 30));
  const requiredMonthly = monthsLeft > 0 ? remaining / monthsLeft : remaining;
  const monthsSince = Math.max(1, Math.round((new Date() - parseISO(paceStart)) / 86400000 / 30));
  const pace = (per1 + per2) / monthsSince;
  return { saved, pct, remaining, daysLeft, monthsLeft, requiredMonthly, pace, per1, per2, auto: !!g.auto, profitPid };
}

