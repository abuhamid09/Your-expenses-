    if (!dueDate) return toast('اختر التاريخ المستهدف', 'error');
    if (isNew) Repo.insert('goals', { id: uid(), name, targetAmount, dueDate, initialSaved, contributions: [], createdAt: todayISO(), auto, autoStart });
    else Repo.update('goals', goal.id, { name, targetAmount, dueDate, initialSaved, auto, autoStart });
    Modal.close(); toast(isNew ? 'تم إنشاء الهدف — وفّقا! 🎯' : 'تم تحديث الهدف ✔');
    renderGoals();
  });
}

