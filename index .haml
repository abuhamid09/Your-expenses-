function importData(file) {
  if (!file) return;
  const reader = new FileReader();
  reader.onload = evt => processImportedData(evt.target.result);
  reader.onerror = () => toast('فشل قراءة الملف', 'error');
  reader.readAsText(file);
}

function processImportedData(rawText) {
  try {
    let imported = JSON.parse(String(rawText).trim());
    if (!imported.people || !Array.isArray(imported.transactions))
      return toast('بيانات غير صالحة — تأكد أنها نسخة دفترنا', 'error');
    if (imported.debts && imported.debts.length && imported.debts[0].type !== undefined && imported.debts[0].entries === undefined) {
      imported = migrateV1toV2(imported);
    }
    const safeState = {
      people: imported.people,
      transactions: imported.transactions,
      sources: imported.sources || [],
      goals: imported.goals || [],
      debts: imported.debts || [],
      monthGoals: imported.monthGoals || {},
      budget: imported.budget || { ...BUDGET_DEFAULT, tx: [] },
      categories: imported.categories || null,
      settings: Object.assign({ theme: null, currency: '', profitPersonId: 1 }, imported.settings || {})
    };
    if (!safeState.categories) safeState.categories = { expense: CONFIG.expenseCategories.map(c=>({...c})), income: CONFIG.incomeCategories.map(c=>({...c})) };
    confirmDialog(`سيتم استبدال البيانات الحالية بـ <b>${fmtNumber(safeState.transactions.length)} معاملة</b>. هل تريد المتابعة؟`, () => {
      state = safeState; DB.data = state; DB.save();
      normalizeDebts(); DB.save();
      Modal.close(); toast('تم استيراد البيانات بنجاح ✔');
      Recurring.generate(); renderCurrent();
    });
  } catch (e) {
    toast('النص تالف أو غير كامل', 'error');
  }
}

function saveInternalSnapshot() {
  try {
    localStorage.setItem(CONFIG.storageKey + ':snapshot', JSON.stringify({ ts: Date.now(), data: state }));
    toast('حُفظت نسخة داخلية آمنة ✔');
  } catch (e) { toast('تعذّر الحفظ الداخلي', 'error'); }
}

function restoreInternalSnapshot() {
  try {
    const raw = localStorage.getItem(CONFIG.storageKey + ':snapshot');
    if (!raw) return toast('لا توجد نسخة داخلية محفوظة بعد', 'info');
    const snap = JSON.parse(raw);
    const when = toLatin(new Intl.DateTimeFormat('ar', { dateStyle: 'medium', timeStyle: 'short' }).format(new Date(snap.ts)));
    confirmDialog(`ستُستعاد النسخة الداخلية المحفوظة بتاريخ <b>${when}</b> وتُستبدل البيانات الحالية.`, () => {
      state = snap.data; DB.data = state; DB.save();
      normalizeDebts(); DB.save();
      Modal.close(); toast('تمت الاستعادة بنجاح ✔');
      Recurring.generate(); renderCurrent();
    });
  } catch (e) { toast('النسخة الداخلية تالفة', 'error'); }
}

