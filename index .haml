      const lbl2 = g.auto ? `ادخار ${escapeHtml(p2.name)}${(s.profitPid!==0 && p2.id===s.profitPid) ? ' (ربح 20%)' : ' (كامل)'}` : `مساهمة ${escapeHtml(p2.name)}`;
      const autoNote = g.auto ? `<div style="grid-column:1/-1"><span>يُحسب تلقائيًا منذ</span><b>${fmtDate(g.autoStart || g.createdAt || todayISO())}</b></div>` : '';
      return `<article class="card goal-card">
