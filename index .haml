    <div class="field"><label>الفئة</label><div class="cat-grid" data-role="cats"></div></div>
    <div class="field-row">
      <div class="field"><label>ملاحظة</label><input id="${p}Note" maxlength="80" value="${escapeHtml(tx.note || '')}"></div>
      <div class="field"><label>التاريخ</label><input type="date" id="${p}Date" value="${tx.date || todayISO()}"></div>
