function monthSavingsFor(mk) {
  const profitPid = getProfitPid();
  let sum = 0;
  for (const p of state.people) {
    const t = Stats.totals(Stats.inMonth(Stats.ofPerson(state.transactions, p.id), mk));
    sum += Math.max(0, (profitPid !== 0 && p.id === profitPid) ? t.net * CONFIG.partnerProfitRate : t.net);
  }
  return sum;
}

function renderMonthlyGoals() {
  const holder = $('#goalAnalysis');
  if (!holder) return;
  const year = new Date().getFullYear();
  const curMk = currentMonthKey();
  const curTarget = +state.monthGoals[curMk] || 0;
  const curAch = monthSavingsFor(curMk);
  const curSurplus = curTarget > 0 ? Math.max(0, curAch - curTarget) : 0;
  const curPct = curTarget > 0 ? Math.min(100, (curAch / curTarget) * 100) : (curAch > 0 ? 100 : 0);
  const curStart = `${curMk}-01`;
  const curEnd = `${curMk}-${pad(daysInMonthOf(curMk))}`;
  const topCard = `<div class="card current-month-card">
    <div class="cm-top"><b>📅 ${monthLabel(curMk)} — الشهر الحالي</b><span>بداية ${fmtDate(curStart)} → نهاية ${fmtDate(curEnd)}</span></div>
    <div class="cm-mid">
      <span>الهدف: <b>${curTarget > 0 ? fmtMoney(curTarget) : 'غير محدد'}</b></span>
      <span>المحقق: <b class="in">${fmtMoney(curAch)}</b></span>
      ${curSurplus > 0 ? `<span class="surplus-badge">💰 فائض: ${fmtMoney(curSurplus)}</span>` : ''}
    </div>
    <div class="share-bar"><i style="width:${curPct.toFixed(2)}%;background:${curPct >= 100 ? 'var(--income)' : 'var(--gold)'}"></i></div>
    <span class="share-pct">${fmtNumber(+curPct.toFixed(2))}%</span>
  </div>`;
  let totalTarget = 0, totalCounted = 0, totalSurplus = 0;
  const rows = [];
  for (let m = 0; m < 12; m++) {
    const mk = `${year}-${pad(m + 1)}`;
    const target = +state.monthGoals[mk] || 0;
    const ach = monthSavingsFor(mk);
    const counted = target > 0 ? Math.min(ach, target) : ach;
    const surplus = target > 0 ? Math.max(0, ach - target) : 0;
    totalTarget += target; totalCounted += counted; totalSurplus += surplus;
    const pct = target > 0 ? Math.min(100, (ach / target) * 100) : (ach > 0 ? 100 : 0);
    const done = target > 0 && ach >= target;
    rows.push(`<div class="share-row top">
      <span class="avatar av-month">${fmtNumber(m + 1)}</span>
      <div class="share-info">
        <div class="share-top"><b>${monthLabel(mk)} ${done ? '✅' : ''}</b><span class="${ach > 0 ? 'in' : ''}">${fmtMoney(ach)}</span></div>
        <div class="share-sub">الهدف: ${target > 0 ? fmtMoney(target) : 'غير محدد'} • من 1 إلى ${fmtNumber(daysInMonthOf(mk))}</div>
        <div class="share-bar"><i style="width:${pct.toFixed(2)}%;background:${done ? 'var(--income)' : 'var(--gold)'}"></i></div>
        <span class="share-pct">${fmtNumber(+pct.toFixed(2))}%${surplus > 0 ? ` • <span class="surplus-inline">فائض ${fmtMoney(surplus)}</span>` : ''}</span>
      </div>
      <button class="icon-btn sm" data-action="edit-month-goal" data-id="${mk}" aria-label="تعديل هدف الشهر"><svg class="ic"><use href="#i-edit"/></svg></button>
    </div>`);
  }
  const yPct = totalTarget > 0 ? Math.min(100, (totalCounted / totalTarget) * 100) : (totalCounted > 0 ? 100 : 0);
  holder.innerHTML = topCard + `<div class="card chart-card" style="margin-top:14px">
    <h3>الأهداف الشهرية — ${fmtNumber(year)}</h3>
    <p class="hint" style="margin-bottom:10px">حدّدا هدف كل شهر بزر ✏️ — المحقق يُحسب تلقائيًا، والفائض يُسجل مفصولًا.</p>
    <div class="share-list">${rows.join('')}</div>
    <div class="year-total">
      <div class="share-top"><b>🏁 إجمالي المحقق</b><span class="in">${fmtMoney(totalCounted)}</span></div>
      <div class="share-sub">إجمالي الأهداف: ${totalTarget > 0 ? fmtMoney(totalTarget) : 'غير محدد'}</div>
      <div class="share-bar"><i style="width:${yPct.toFixed(2)}%;background:linear-gradient(90deg,var(--gold),var(--primary))"></i></div>
      <span class="share-pct">${fmtNumber(+yPct.toFixed(2))}%</span>
      ${totalSurplus > 0 ? `<div class="surplus-badge" style="margin-top:8px">💰 فائض مفصول: ${fmtMoney(totalSurplus)}</div>` : ''}
    </div>
  </div>`;
}

