<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>دفترنا — دفتر المصروفات المشترك</title>
<link rel="manifest" href="manifest.webmanifest">
<meta name="theme-color" content="#0e6d5a">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="دفترنا">
<link rel="apple-touch-icon" href="icon.svg">
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>📒</text></svg>">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Markazi+Text:wght@400;500;600;700&family=Tajawal:wght@400;500;700;800&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<style>
:root{--bg:#eef3ef;--bg-soft:#e3ebe4;--surface:#ffffff;--surface-2:#f4f8f4;--ink:#17251f;--muted:#5f6f66;--line:#dbe4dc;--primary:#0e6d5a;--primary-deep:#0a5646;--gold:#c9962e;--income:#1c9e6f;--expense:#d84f4f;--chart-grid:rgba(23,37,31,.08);--shadow:0 10px 30px -14px rgba(15,45,36,.22);--hero-a:#0b4a3d;--hero-b:#0e6d5a;--hero-c:#14836b}
[data-theme="dark"]{--bg:#0d1613;--bg-soft:#0a120f;--surface:#152420;--surface-2:#1b2d27;--ink:#e8f1ea;--muted:#96ac9f;--line:#24382f;--primary:#2fbf9a;--primary-deep:#1d9b7c;--gold:#e2b457;--income:#3ec98f;--expense:#f07a72;--chart-grid:rgba(232,241,234,.08);--shadow:0 12px 32px -14px rgba(0,0,0,.55)}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:'Tajawal',sans-serif;color:var(--ink);background:var(--bg);background-image:radial-gradient(700px 320px at 88% -60px,rgba(201,150,46,.14),transparent 60%),radial-gradient(640px 340px at -80px 280px,rgba(14,109,90,.13),transparent 55%);background-attachment:fixed;min-height:100dvh;padding-bottom:170px;transition:background-color .3s,color .3s}
::selection{background:rgba(201,150,46,.35)}
button{font-family:inherit}
:focus-visible{outline:2.5px solid var(--gold);outline-offset:2px}
.ic{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;flex:none}
.currency{display:none!important}
.topbar{position:sticky;top:0;z-index:30;display:flex;align-items:center;justify-content:space-between;gap:10px;padding:12px 16px;border-bottom:1px solid var(--line);background:color-mix(in srgb,var(--bg) 80%,transparent);backdrop-filter:blur(10px)}
.brand{display:flex;align-items:center;gap:10px}
.brand-badge{width:42px;height:42px;border-radius:12px;display:grid;place-items:center;color:#fff;background:linear-gradient(135deg,var(--gold),#a87a1f);box-shadow:0 6px 16px -6px rgba(201,150,46,.6)}
.brand h1{font-family:'Markazi Text',serif;font-size:1.55rem;line-height:1;font-weight:700}
.brand-sub{font-size:.72rem;color:var(--muted);font-weight:500}
.topbar-actions{display:flex;align-items:center;gap:8px}
.month-pill{font-size:.75rem;font-weight:700;color:var(--primary);background:color-mix(in srgb,var(--primary) 12%,transparent);padding:7px 12px;border-radius:99px;border:1px solid color-mix(in srgb,var(--primary) 25%,transparent);white-space:nowrap}
.icon-btn{width:38px;height:38px;border-radius:11px;display:grid;place-items:center;background:var(--surface);border:1px solid var(--line);color:var(--ink);cursor:pointer;transition:.2s}
.icon-btn:hover{transform:translateY(-2px);box-shadow:var(--shadow)}
.icon-btn.sm{width:30px;height:30px;border-radius:8px}
.icon-btn.sm .ic{width:15px;height:15px}
.icon-btn.danger:hover{color:var(--expense);border-color:var(--expense)}
.img-btn{font-size:1rem;background:var(--surface-2)}
main{max-width:1080px;margin-inline:auto;padding:18px 16px}
.view{display:none}
.view.is-active{display:block;animation:viewIn .32s ease}
@keyframes viewIn{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:none}}
.view-title{font-family:'Markazi Text',serif;font-size:1.5rem;font-weight:600;margin:26px 0 12px;display:flex;align-items:center;gap:9px}
.view-title::before{content:'';width:5px;height:22px;border-radius:4px;background:linear-gradient(180deg,var(--gold),var(--primary))}
.view-head{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;margin-bottom:6px}
.view-head .view-title{margin:0}
.hint{font-size:.82rem;color:var(--muted);margin-bottom:14px;line-height:1.7}
.card{background:var(--surface);border:1px solid var(--line);border-radius:16px;padding:16px;box-shadow:var(--shadow);transition:transform .2s,box-shadow .2s}
.hero-card{position:relative;overflow:hidden;border-radius:20px;padding:22px 22px 14px;color:#f4fbf7;background:radial-gradient(130% 170% at 88% -25%,rgba(226,180,87,.38),transparent 52%),linear-gradient(140deg,var(--hero-a),var(--hero-b) 55%,var(--hero-c));box-shadow:0 18px 40px -16px rgba(10,70,56,.55)}
.hero-card::after{content:'';position:absolute;inset:0;pointer-events:none;opacity:.45;background-image:radial-gradient(rgba(255,255,255,.16) 1px,transparent 1.5px);background-size:22px 22px}
.hero-top{display:flex;justify-content:space-between;align-items:center;position:relative;z-index:1}
.hero-label{font-size:.85rem;font-weight:700;opacity:.9;letter-spacing:.3px}
.hero-top .ic{width:26px;height:26px;color:#e2b457}
.hero-amount{font-family:'Markazi Text',serif;font-size:clamp(2.7rem,10vw,3.8rem);font-weight:700;line-height:1.15;position:relative;z-index:1}
.hero-meta{display:flex;gap:8px;flex-wrap:wrap;position:relative;z-index:1}
.pill{display:inline-flex;align-items:center;gap:6px;font-size:.78rem;font-weight:700;padding:6px 12px;border-radius:99px;background:rgba(255,255,255,.15);border:1px solid rgba(255,255,255,.22)}
.pill .dot{width:8px;height:8px;border-radius:50%}
.pill .dot.g{background:#7ce3b1}.pill .dot.r{background:#ffb0a8}
#sparkline{width:100%;height:48px;display:block;margin-top:12px;position:relative;z-index:1}
.period-compact{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;padding:10px}
.pc-col{text-align:center;background:var(--surface-2);border:1px solid var(--line);border-radius:10px;padding:8px 4px}
.pc-col span{display:block;font-size:.68rem;color:var(--muted);font-weight:800;margin-bottom:2px}
.pc-col b{display:block;font-family:'Markazi Text',serif;font-size:1.15rem;font-weight:700;line-height:1.2}
.pc-col small{display:block;font-size:.6rem;color:var(--muted);margin-top:2px}
.dot{width:8px;height:8px;border-radius:50%;flex:none}
.dot.in,.in{color:var(--income)}.dot.in{background:var(--income)}
.dot.out,.out{color:var(--expense)}.dot.out{background:var(--expense)}
.person-grid{display:grid;gap:12px}
@media(min-width:700px){.person-grid{grid-template-columns:1fr 1fr}}
.person-card{padding:16px}
.pc-head{display:flex;align-items:center;gap:10px;margin-bottom:12px}
.pc-head h3{font-size:1.05rem;font-weight:800}
.pc-head span{font-size:.72rem;color:var(--muted)}
.avatar{width:40px;height:40px;border-radius:12px;display:grid;place-items:center;color:#fff;font-weight:800;font-size:1.05rem;flex:none}
.av-1{background:linear-gradient(135deg,#0e6d5a,#2fbf9a)}
.av-2{background:linear-gradient(135deg,#c9962e,#e2b457)}
.av-month{background:linear-gradient(135deg,var(--primary),var(--income));font-size:.95rem}
.pc-row{display:flex;justify-content:space-between;font-size:.88rem;padding:6px 0;border-bottom:1px dashed var(--line);font-weight:600}
.pc-row span{color:var(--muted)}
.pc-row.total{border:0}
.pc-row.total b{font-family:'Markazi Text',serif;font-size:1.25rem}
.profit-line{margin-top:12px;display:flex;align-items:center;gap:8px;font-size:.8rem;font-weight:700;background:color-mix(in srgb,var(--gold) 13%,transparent);border:1px dashed color-mix(in srgb,var(--gold) 45%,transparent);border-radius:11px;padding:9px 11px;color:var(--ink)}
.profit-line .ic{color:var(--gold);width:17px;height:17px}
.profit-line b{margin-inline-start:auto;font-family:'Markazi Text',serif;font-size:1.1rem;color:var(--gold)}
.recent-head{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap}
.recent-tools{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
.search-box{display:flex;align-items:center;gap:7px;background:var(--surface);border:1.5px solid var(--line);border-radius:11px;padding:8px 12px}
.search-box input{border:0;background:none;padding:0;width:150px;font-size:.85rem}
.search-box input:focus{outline:none}
.search-box .ic{width:16px;height:16px;color:var(--muted)}
.fchip{border:1.5px solid var(--line);background:var(--surface);color:var(--muted);border-radius:99px;padding:7px 14px;font-size:.78rem;font-weight:700;cursor:pointer;transition:.18s;flex:none}
.fchip:hover{border-color:var(--primary)}
.fchip.sel{background:var(--primary);border-color:var(--primary);color:#fff}
.adv-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
@media(max-width:480px){.adv-grid{grid-template-columns:1fr}}
.adv-summary{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin:12px 0}
@media(max-width:480px){.adv-summary{grid-template-columns:repeat(2,1fr)}}
.adv-sum{background:var(--surface-2);border:1px solid var(--line);border-radius:10px;padding:8px;text-align:center}
.adv-sum b{display:block;font-family:'Markazi Text',serif;font-size:1.1rem}
.adv-sum span{font-size:.68rem;color:var(--muted);font-weight:700}
.adv-results{display:flex;flex-direction:column;gap:8px;max-height:45vh;overflow:auto}
.adv-actions{display:flex;gap:8px;margin-top:4px;flex-wrap:wrap}
.select-bar{display:flex;gap:8px;align-items:center;justify-content:space-between;padding:10px 12px;margin-bottom:10px}
.tx-list{list-style:none;display:flex;flex-direction:column;gap:8px}
.tx-item{display:flex;align-items:center;gap:12px;background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:11px 13px;animation:itemIn .38s both;transition:transform .18s,box-shadow .18s}
.tx-item:hover{transform:translateX(-3px);box-shadow:var(--shadow)}
.tx-item.selectable{cursor:pointer}
.tx-item.selected{border-color:var(--expense);background:color-mix(in srgb,var(--expense) 8%,var(--surface))}
.tx-check{width:22px;height:22px;border-radius:7px;border:2px solid var(--line);display:grid;place-items:center;font-size:.8rem;color:transparent;flex:none;background:var(--surface)}
.tx-item.selected .tx-check{background:var(--expense);border-color:var(--expense);color:#fff}
@keyframes itemIn{from{opacity:0;transform:translateX(14px)}to{opacity:1}}
.tx-icon{width:42px;height:42px;border-radius:12px;display:grid;place-items:center;font-size:1.25rem;flex:none}
.tx-info{flex:1;min-width:0;display:flex;flex-direction:column;gap:1px}
.tx-info strong{font-size:.95rem;display:flex;align-items:center;gap:6px;color:var(--ink);flex-wrap:wrap}
.tx-info .bal-lbl{font-size:.78rem;font-weight:800}
.tx-info .auto{font-size:.7rem;color:var(--muted)}
.tx-info span{font-size:.85rem;color:var(--ink);font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.tx-info time{font-size:.78rem;color:var(--muted)}
.tx-side{display:flex;flex-direction:column;align-items:flex-end;gap:4px}
.tx-side>b{font-family:'Markazi Text',serif;font-size:1.2rem;font-weight:700;white-space:nowrap}
.tx-actions{display:flex;gap:5px}
.btn{border:0;border-radius:12px;padding:11px 20px;font-weight:800;font-size:.92rem;cursor:pointer;transition:.18s;display:inline-flex;align-items:center;gap:7px;justify-content:center;text-decoration:none}
.btn:active{transform:scale(.97)}
.btn-primary{background:var(--primary);color:#fff;box-shadow:0 8px 20px -8px color-mix(in srgb,var(--primary) 60%,transparent)}
.btn-primary:hover{background:var(--primary-deep);transform:translateY(-2px)}
.btn-gold{background:var(--gold);color:#fff}
.btn-gold:hover{filter:brightness(1.08);transform:translateY(-2px)}
.btn-ghost{background:var(--surface-2);color:var(--ink);border:1.5px solid var(--line)}
.btn-ghost:hover{border-color:var(--primary)}
.btn-danger{background:var(--expense);color:#fff}
.btn-income{background:var(--income);color:#fff}
.btn-income:hover{filter:brightness(1.1);transform:translateY(-2px)}
.btn-expense{background:var(--expense);color:#fff}
.btn-expense:hover{filter:brightness(1.1);transform:translateY(-2px)}
.btn-lg{width:100%;padding:14px;font-size:1.02rem}
.form-stack{display:flex;flex-direction:column;gap:14px}
.field label{display:block;font-size:.8rem;font-weight:800;color:var(--muted);margin-bottom:7px}
.field-row{display:grid;grid-template-columns:1fr 1fr;gap:12px}
@media(max-width:480px){.field-row{grid-template-columns:1fr}}
input,select,textarea{font-family:inherit;font-size:.95rem;color:var(--ink);background:var(--surface-2);border:1.5px solid var(--line);border-radius:11px;padding:10px 12px;width:100%;transition:border-color .2s}
input:focus,textarea:focus,select:focus{outline:none;border-color:var(--primary)}
input:disabled{opacity:.5;cursor:not-allowed}
select{appearance:none;background-image:linear-gradient(45deg,transparent 50%,var(--muted) 50%),linear-gradient(135deg,var(--muted) 50%,transparent 50%);background-position:calc(0% + 18px) 50%,calc(0% + 12px) 50%;background-size:6px 6px;background-repeat:no-repeat}
.amount-wrap{position:relative}
.amount-wrap input{font-family:'Markazi Text',serif;font-size:1.9rem;text-align:center;padding:8px 40px}
.person-pick{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.person-btn{display:flex;align-items:center;gap:8px;justify-content:center;border:1.5px solid var(--line);background:var(--surface-2);border-radius:12px;padding:9px;font-weight:800;font-size:.9rem;color:var(--muted);cursor:pointer;transition:.18s}
.person-btn .avatar{width:30px;height:30px;font-size:.85rem;border-radius:9px}
.person-btn.sel{border-color:var(--gold);color:var(--ink);background:color-mix(in srgb,var(--gold) 10%,var(--surface-2));box-shadow:0 0 0 3px color-mix(in srgb,var(--gold) 22%,transparent)}
.seg{display:grid;grid-template-columns:1fr 1fr;gap:4px;background:var(--surface-2);border:1.5px solid var(--line);border-radius:12px;padding:4px}
.seg button{border:0;background:transparent;padding:9px;border-radius:9px;font-weight:800;color:var(--muted);cursor:pointer;transition:.18s;font-size:.93rem}
.seg button.on-expense{background:var(--expense);color:#fff;box-shadow:0 4px 12px -4px var(--expense)}
.seg button.on-income{background:var(--income);color:#fff;box-shadow:0 4px 12px -4px var(--income)}
.cat-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(86px,1fr));gap:8px}
.cat-chip{position:relative}
.cat-chip input{position:absolute;opacity:0;pointer-events:none}
.cat-chip span{display:flex;flex-direction:column;align-items:center;gap:4px;padding:9px 4px;border:1.5px solid var(--line);border-radius:12px;cursor:pointer;transition:.18s;background:var(--surface-2);font-size:.76rem;font-weight:700;color:var(--muted)}
.cat-chip span em{font-style:normal;font-size:1.2rem}
.cat-chip input:checked+span{border-color:var(--primary);color:var(--ink);transform:scale(1.05);background:color-mix(in srgb,var(--primary) 12%,var(--surface-2));box-shadow:0 5px 14px -6px color-mix(in srgb,var(--primary) 50%,transparent)}
.cat-chip:hover span{border-color:var(--primary)}
.cat-manage-list{display:flex;flex-direction:column;gap:8px;max-height:300px;overflow:auto}
.cat-row{display:flex;align-items:center;gap:10px;padding:8px 10px;background:var(--surface-2);border:1px solid var(--line);border-radius:12px}
.cat-ic{font-size:1.2rem}
.cat-lb{flex:1;font-weight:700}
.dh-img{width:40px;height:40px;object-fit:cover;border-radius:10px;border:1px solid var(--line);cursor:pointer;flex:none}
.img-prev{width:64px;height:64px;object-fit:cover;border-radius:10px;border:1px solid var(--line)}
.debt-history{display:flex;flex-direction:column;gap:6px;max-height:420px;overflow:auto}
.dh-title{font-size:.8rem;font-weight:800;color:var(--muted);margin-bottom:6px}
.dh-row{display:grid;grid-template-columns:auto auto 1fr auto;gap:10px;align-items:center;padding:10px;background:var(--surface);border-radius:12px;border:1px solid var(--line);border-inline-start-width:4px}
.dh-row.k-to_us{border-inline-start-color:var(--income)}
.dh-row.k-we_owe{border-inline-start-color:var(--expense)}
.dh-col{display:flex;flex-direction:column;gap:2px;min-width:0}
.c-type b{font-size:1rem;font-weight:800}
.c-amt b{font-family:'Markazi Text',serif;font-size:1.15rem;font-weight:700}
.c-amt time{font-size:.72rem;color:var(--muted)}
.c-det{align-items:flex-start}
.c-det span{font-size:.85rem;font-weight:600;word-break:break-word}
.c-det .dh-img{margin-bottom:2px}
.c-bal{align-items:flex-end}
.c-bal>b{font-family:'Markazi Text',serif;font-size:1.1rem;font-weight:700}
.dh-actions{display:flex;gap:4px}
.day-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(42px,1fr));gap:6px}
.day-grid button{border:1.5px solid var(--line);background:var(--surface-2);border-radius:9px;padding:7px 0;font-weight:800;font-size:.82rem;color:var(--muted);cursor:pointer;transition:.15s}
.day-grid button.sel{background:var(--primary);border-color:var(--primary);color:#fff;transform:scale(1.06)}
.check-line{display:flex;align-items:center;gap:8px;font-size:.88rem;font-weight:700}
.check-line input{width:18px;height:18px;accent-color:var(--primary)}
.form-actions{display:flex;gap:10px;justify-content:flex-start;margin-top:4px;flex-wrap:wrap}
.backup-actions{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:2px}
.backup-actions .btn{font-size:.8rem;padding:10px 8px}
.backup-actions .btn .ic{width:16px;height:16px}
@media(max-width:420px){.backup-actions{grid-template-columns:1fr}}
.file-input-hidden{display:none}
.export-area{width:100%;min-height:180px;font-family:monospace;font-size:.72rem;padding:10px;border-radius:10px;background:var(--surface-2);color:var(--ink);border:1.5px solid var(--line);direction:ltr;text-align:left;white-space:pre;overflow:auto;resize:vertical}
.steps-list{margin:0 0 12px;padding-inline-start:18px;line-height:2;font-size:.85rem;color:var(--muted);font-weight:600}
.auto-badge{font-size:.68rem;font-weight:800;color:var(--primary);background:color-mix(in srgb,var(--primary) 12%,transparent);padding:3px 9px;border-radius:99px;margin-inline-start:6px;vertical-align:middle}
.note-chips{display:flex;gap:6px;margin-top:8px;flex-wrap:wrap}
.current-month-card{margin-top:14px;border:2px solid color-mix(in srgb,var(--gold) 45%,var(--line))}
.cm-top{display:flex;justify-content:space-between;align-items:center;font-size:.92rem;font-weight:800;margin-bottom:8px;gap:8px;flex-wrap:wrap}
.cm-top span{font-size:.72rem;color:var(--muted);font-weight:700}
.cm-mid{display:flex;gap:10px;flex-wrap:wrap;align-items:center;font-size:.8rem;font-weight:700;margin-bottom:8px}
.surplus-badge{display:inline-flex;align-items:center;gap:4px;background:color-mix(in srgb,var(--gold) 15%,transparent);border:1px dashed color-mix(in srgb,var(--gold) 55%,transparent);color:var(--gold);border-radius:99px;padding:3px 10px;font-size:.72rem;font-weight:800}
.surplus-inline{color:var(--gold);font-weight:800}
.share-list{display:flex;flex-direction:column;gap:12px;margin-top:6px}
.share-row{display:flex;align-items:center;gap:10px}
.share-row.top{align-items:flex-start}
.share-row.top .icon-btn{margin-top:2px}
.share-info{flex:1;min-width:0}
.share-top{display:flex;justify-content:space-between;align-items:center;font-size:.9rem;font-weight:800;margin-bottom:4px;gap:8px}
.share-sub{font-size:.72rem;color:var(--muted);font-weight:700;margin-bottom:4px}
.share-bar{height:8px;border-radius:99px;background:var(--surface-2);border:1px solid var(--line);overflow:hidden}
.share-bar i{display:block;height:100%;border-radius:99px}
.share-pct{font-size:.72rem;color:var(--muted);font-weight:700;margin-top:3px;display:block;text-align:left}
.year-total{margin-top:14px;padding-top:12px;border-top:1px dashed var(--line)}
.debt-summary-card{display:flex;flex-direction:column;gap:14px;margin-bottom:14px}
.persons-list{display:grid;gap:12px}
@media(min-width:700px){.persons-list{grid-template-columns:repeat(2,1fr)}}
.person-debt-card{display:flex;align-items:center;gap:12px;cursor:pointer;transition:transform .18s;user-select:none;-webkit-user-select:none}
.person-debt-card:hover{transform:translateX(-3px)}
.person-debt-card .avatar{width:52px;height:52px;border-radius:14px;font-size:1.3rem}
.pd-info{flex:1;min-width:0}
.pd-info h3{font-size:1.1rem;font-weight:800;margin-bottom:4px;color:var(--ink)}
.pd-info span{display:block;font-size:.9rem;color:var(--ink);font-weight:700}
.pd-side{display:flex;flex-direction:column;gap:3px;align-items:flex-end}
.pd-side .net{font-family:'Markazi Text',serif;font-size:1.3rem;font-weight:700}
.back-btn{display:inline-flex;align-items:center;gap:6px;background:var(--surface-2);border:1.5px solid var(--line);padding:7px 12px;border-radius:11px;font-weight:800;font-size:.82rem;color:var(--ink);cursor:pointer;transition:.2s}
.back-btn:hover{border-color:var(--primary);transform:translateX(2px)}
.person-head-card{padding:10px 14px;margin-bottom:10px;background:linear-gradient(135deg, color-mix(in srgb,var(--primary) 6%,var(--surface)), color-mix(in srgb,var(--gold) 8%,var(--surface)));border:2px solid color-mix(in srgb,var(--primary) 30%,var(--line))}
.net-line{font-family:'Markazi Text',serif;font-size:1.35rem;font-weight:700;margin-bottom:4px}
.tug-bar{display:flex;height:10px;border-radius:99px;overflow:hidden;border:1px solid var(--line);background:var(--surface-2);margin:6px 0 4px}
.tug-bar .g{background:var(--income);transition:width .6s}
.tug-bar .r{background:var(--expense);transition:width .6s}
.tug-bar.sm{height:8px;margin:6px 0 0}
.tug-labels{display:flex;justify-content:space-between;font-size:.72rem;font-weight:800;margin-bottom:8px}
.person-head-meta{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:8px}
.phm-box{padding:7px;border-radius:10px;text-align:center}
.phm-box.green{background:color-mix(in srgb,var(--income) 12%,transparent);border:1.5px solid color-mix(in srgb,var(--income) 30%,transparent);color:var(--income)}
.phm-box.red{background:color-mix(in srgb,var(--expense) 12%,transparent);border:1.5px solid color-mix(in srgb,var(--expense) 30%,transparent);color:var(--expense)}
.phm-box span{display:block;font-size:.7rem;font-weight:800;margin-bottom:1px}
.phm-box b{font-family:'Markazi Text',serif;font-size:1.15rem;font-weight:700}
.person-actions-row{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:12px}
.entry-type-seg{display:grid;grid-template-columns:1fr 1fr;gap:4px;background:var(--surface-2);border:1.5px solid var(--line);border-radius:12px;padding:4px}
.entry-type-seg button{border:0;background:transparent;padding:10px;border-radius:9px;font-weight:800;color:var(--muted);cursor:pointer;transition:.18s;font-size:.85rem}
.entry-type-seg button.on-income{background:var(--income);color:#fff}
.entry-type-seg button.on-expense{background:var(--expense);color:#fff}
.budget-tools{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px}
.budget-card{padding:14px;border-inline-start-width:5px}
.bc-head{display:flex;justify-content:space-between;align-items:center;font-weight:800;font-size:.9rem;margin-bottom:8px;gap:8px}
.bc-amt{font-family:'Markazi Text',serif;font-size:1.2rem}
.bc-slider{width:100%;height:26px;accent-color:var(--primary);cursor:pointer}
.bc-slider:disabled{cursor:not-allowed;opacity:.55}
.bc-row{display:flex;justify-content:space-between;align-items:center;margin-top:6px;font-size:.8rem;font-weight:700;color:var(--muted)}
.bc-num{width:64px;text-align:center;padding:4px 6px;font-size:.9rem}
.bc-spend{margin-top:10px;border-top:1px dashed var(--line);padding-top:8px}
.bc-spend-row{display:flex;justify-content:space-between;font-size:.8rem;font-weight:700;margin-bottom:4px}
.source-list{display:flex;flex-direction:column;gap:10px}
.source-card{display:flex;align-items:center;gap:12px}
.src-icon{width:46px;height:46px;border-radius:13px;display:grid;place-items:center;font-size:1.35rem;flex:none}
.src-info{flex:1;min-width:0}
.src-info h3{font-size:.98rem;font-weight:800}
.src-info span{display:block;font-size:.75rem;color:var(--muted);margin-top:2px}
.src-days em{font-style:normal;opacity:.75}
.src-end{display:flex;flex-direction:column;align-items:flex-end;gap:7px}
.src-end b{font-family:'Markazi Text',serif;font-size:1.2rem}
.kpi-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-bottom:20px}
@media(min-width:900px){.kpi-grid{grid-template-columns:repeat(5,1fr)}}
.kpi-card{padding:13px}
.kpi-card h4{font-size:.74rem;color:var(--muted);font-weight:800;margin-bottom:5px}
.kpi-val{font-family:'Markazi Text',serif;font-size:1.55rem;font-weight:700;line-height:1.2}
.kpi-sub{font-size:.68rem;color:var(--muted);margin-top:3px;font-weight:600}
.delta{display:inline-flex;align-items:center;gap:3px;font-size:.7rem;font-weight:800;padding:3px 9px;border-radius:99px;margin-top:5px}
.delta.good{color:var(--income);background:color-mix(in srgb,var(--income) 13%,transparent)}
.delta.bad{color:var(--expense);background:color-mix(in srgb,var(--expense) 13%,transparent)}
.delta.flat{color:var(--muted);background:var(--surface-2)}
.charts-grid{display:grid;gap:14px;grid-template-columns:1fr}
@media(min-width:760px){.charts-grid{grid-template-columns:1fr 1fr}}
@media(min-width:1150px){.charts-grid{grid-template-columns:repeat(3,1fr)}.chart-card.wide{grid-column:span 2}}
.chart-card h3{font-size:.9rem;font-weight:800;margin-bottom:10px;display:flex;align-items:center;gap:7px}
.chart-card h3::before{content:'';width:9px;height:9px;border-radius:3px;background:var(--gold)}
.chart-box{position:relative;height:255px}
.no-data{height:100%;display:grid;place-items:center;color:var(--muted);font-size:.85rem;font-weight:700;border:1.5px dashed var(--line);border-radius:12px}
.habits-grid{display:grid;gap:10px;grid-template-columns:repeat(auto-fit,minmax(250px,1fr))}
.habit-card{display:flex;gap:12px;align-items:flex-start}
.habit-icon{width:44px;height:44px;border-radius:12px;display:grid;place-items:center;font-size:1.3rem;flex:none;background:color-mix(in srgb,var(--primary) 12%,transparent)}
.habit-card h4{font-size:.8rem;color:var(--muted);font-weight:800}
.habit-card p{font-size:.92rem;font-weight:700;margin-top:3px;line-height:1.6}
.tips-list{list-style:none;display:flex;flex-direction:column;gap:8px}
.tip{display:flex;gap:11px;align-items:flex-start;background:var(--surface);border:1px solid var(--line);border-inline-start:4px solid var(--primary);border-radius:13px;padding:12px 14px;font-size:.88rem;line-height:1.75;font-weight:600}
.tip .ic{margin-top:3px}
.tip.danger{border-inline-start-color:var(--expense)}.tip.danger .ic{color:var(--expense)}
.tip.warn{border-inline-start-color:var(--gold)}.tip.warn .ic{color:var(--gold)}
.tip.good{border-inline-start-color:var(--income)}.tip.good .ic{color:var(--income)}
.tip.info .ic{color:var(--primary)}
.goal-list{display:grid;gap:14px}
@media(min-width:800px){.goal-list{grid-template-columns:1fr 1fr}}
.goal-card header{display:flex;justify-content:space-between;align-items:flex-start;gap:8px;margin-bottom:12px}
.goal-card h3{font-size:1.1rem;font-weight:800}
.goal-due{font-size:.72rem;color:var(--muted);font-weight:700;display:flex;align-items:center;gap:4px}
.goal-progress{display:flex;align-items:center;gap:12px;margin-bottom:12px}
.goal-pct{font-family:'Markazi Text',serif;font-size:1.7rem;font-weight:700;color:var(--gold);min-width:58px;text-align:center}
.bar{flex:1;height:13px;border-radius:99px;background:var(--surface-2);border:1px solid var(--line);overflow:hidden}
.bar i{display:block;height:100%;width:0;border-radius:99px;background:linear-gradient(90deg,var(--gold),var(--primary));transition:width .9s cubic-bezier(.2,.8,.2,1)}
.goal-meta{display:grid;grid-template-columns:1fr 1fr;gap:7px 14px;margin-bottom:14px}
.goal-meta div{display:flex;justify-content:space-between;font-size:.79rem;font-weight:700;border-bottom:1px dashed var(--line);padding-bottom:5px}
.goal-meta span{color:var(--muted)}
.goal-actions{display:flex;gap:8px;flex-wrap:wrap}
.goal-actions .btn{padding:8px 14px;font-size:.8rem}
.bottom-nav{position:fixed;bottom:12px;right:50%;transform:translateX(50%);display:flex;gap:2px;z-index:50;background:var(--surface);border:1px solid var(--line);border-radius:18px;padding:6px;box-shadow:0 16px 38px -12px rgba(0,0,0,.4);max-width:96vw;overflow-x:auto}
.bottom-nav button{display:flex;flex-direction:column;align-items:center;gap:3px;border:0;background:transparent;color:var(--muted);font-size:.6rem;font-weight:800;padding:7px 5px;border-radius:13px;cursor:pointer;transition:.2s;min-width:46px;position:relative;flex:none}
.bottom-nav button .ic{width:20px;height:20px;transition:transform .2s}
.bottom-nav button.active{color:var(--primary);background:color-mix(in srgb,var(--primary) 13%,transparent)}
.bottom-nav button.active .ic{transform:translateY(-2px) scale(1.12)}
.fab{position:fixed;bottom:92px;left:18px;width:56px;height:56px;border-radius:50%;border:0;cursor:pointer;z-index:40;background:linear-gradient(135deg,var(--gold),#a87a1f);color:#fff;display:grid;place-items:center;box-shadow:0 12px 28px -8px rgba(201,150,46,.65);transition:.2s}
.fab .ic{width:24px;height:24px;stroke-width:2.4}
.fab:hover{transform:scale(1.08) rotate(90deg)}
.modal-root{position:fixed;inset:0;z-index:90;pointer-events:none}
.modal-root.open{pointer-events:auto}
.modal-backdrop{position:absolute;inset:0;background:rgba(6,14,11,.55);backdrop-filter:blur(3px);opacity:0;transition:.25s}
.modal-root.show .modal-backdrop{opacity:1}
.modal{position:absolute;background:var(--surface);border:1px solid var(--line);padding:20px;bottom:0;right:0;left:0;border-radius:22px 22px 0 0;max-height:88dvh;overflow:auto;transform:translateY(50px);opacity:0;transition:.3s cubic-bezier(.2,.8,.25,1)}
.modal-root.show .modal{transform:none;opacity:1}
@media(min-width:640px){.modal{bottom:auto;top:50%;right:auto;left:50%;width:min(540px,94vw);border-radius:20px;transform:translate(-50%,-46%) scale(.96)}.modal-root.show .modal{transform:translate(-50%,-50%) scale(1)}}
.modal-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:16px}
.modal-head h3{font-family:'Markazi Text',serif;font-size:1.45rem;font-weight:700}
.confirm-box{text-align:center;padding:8px 4px}
.confirm-box .big-ic{width:58px;height:58px;border-radius:50%;display:grid;place-items:center;margin:0 auto 12px;color:var(--expense);background:color-mix(in srgb,var(--expense) 13%,transparent)}
.confirm-box p{color:var(--muted);font-size:.9rem;margin:8px 0 18px;line-height:1.8}
.confirm-box .form-actions{justify-content:center}
.toast-root{position:fixed;bottom:100px;left:50%;transform:translateX(-50%);z-index:120;display:flex;flex-direction:column;gap:8px;width:min(92vw,400px)}
.toast{display:flex;align-items:center;gap:9px;background:var(--ink);color:var(--bg);padding:12px 16px;border-radius:13px;font-weight:700;font-size:.87rem;box-shadow:0 12px 30px -10px rgba(0,0,0,.5);animation:toastIn .3s cubic-bezier(.2,.8,.3,1)}
.toast .ic{width:18px;height:18px}
.toast.success .ic{color:#5fe0a8}.toast.error .ic{color:#ff9d94}.toast.info .ic{color:#e2b457}
.toast.out{animation:toastOut .3s forwards}
@keyframes toastIn{from{opacity:0;transform:translateY(16px) scale(.95)}}
@keyframes toastOut{to{opacity:0;transform:translateY(10px)}}
.empty-state{text-align:center;padding:42px 20px}
.empty-state .em{font-size:2.6rem;display:block;margin-bottom:10px}
.empty-state h3{font-family:'Markazi Text',serif;font-size:1.45rem;margin-bottom:5px}
.empty-state p{color:var(--muted);font-size:.88rem;margin-bottom:16px;line-height:1.8}
.empty-state .btn{margin:4px}
.reveal{opacity:0;transform:translateY(18px);transition:opacity .55s ease,transform .55s ease}
.reveal.in{opacity:1;transform:none}
@media (prefers-reduced-motion:reduce){*{animation-duration:.01ms!important;transition-duration:.01ms!important}}
</style>
</head>
<body>
