<script>
(function () {
'use strict';

const CONFIG = {
  storageKey: 'daftar-mushtarak:v2',
  monthsWindow: 6,
  partnerProfitRate: 0.20,
  recentLimit: 10,
  currencyDefault: '',
  expenseCategories: [
    { id:'food', label:'طعام', icon:'🍽️', color:'#f59e42' },
    { id:'transport', label:'مواصلات', icon:'🚌', color:'#4aa3c0' },
    { id:'housing', label:'سكن', icon:'🏠', color:'#8a67c9' },
    { id:'bills', label:'فواتير', icon:'🧾', color:'#3aa793' },
    { id:'health', label:'صحة', icon:'💊', color:'#e2557b' },
    { id:'education', label:'تعليم', icon:'📚', color:'#c5ae4a' },
    { id:'fun', label:'ترفيه', icon:'🎮', color:'#e2708f' },
    { id:'shopping', label:'تسوق', icon:'🛍️', color:'#5f8fd4' },
    { id:'other', label:'أخرى', icon:'📦', color:'#93a09b' }
  ],
  incomeCategories: [
    { id:'salary', label:'رصيد', icon:'💼', color:'#2f9d74' },
    { id:'freelance', label:' شحن', icon:'💻', color:'#2b8fa3' },
    { id:'gift', label:'هدية', icon:'🎁', color:'#d4698f' },
    { id:'invest', label:'استثمار', icon:'📈', color:'#c9962e' },
    { id:'other', label:'أخرى', icon:'✨', color:'#93a09b' }
  ]
};

const BUDGET_CATS = [
  { key:'save',    label:'ادخار / استثمار', icon:'💰', color:'#2f9d74' },
  { key:'expense', label:'مصروف',           icon:'🧾', color:'#e2708f' },
  { key:'fun',     label:'ترفيه',           icon:'🎮', color:'#e2b457' }
];
const BUDGET_DEFAULT = { income: 0, save: 60, expense: 20, fun: 20, locked: true, tx: [] };

const $  = (s, r = document) => r.querySelector(s);
const $$ = (s, r = document) => [...r.querySelectorAll(s)];
const uid = () => Date.now().toString(36) + Math.random().toString(36).slice(2, 7);
const pad = n => String(n).padStart(2, '0');
const escapeHtml = s => String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));

const AR = '٠١٢٣٤٥٦٧٨٩', FA = '۰۱۲٣٤٥٦٧٨٩';
const toLatin = s => String(s).replace(/[٠-٩۰-۹]/g, c => {
  const a = AR.indexOf(c); if (a > -1) return a;
  const f = FA.indexOf(c); if (f > -1) return f;
  return c;
});
const nf0 = new Intl.NumberFormat('en-US', { maximumFractionDigits: 0 });
const nf2 = new Intl.NumberFormat('en-US', { maximumFractionDigits: 2 });
const fmtNumber = n => toLatin((Number.isInteger(+n) ? nf0 : nf2).format(n || 0));

function parseAmount(v) {
  const s = toLatin(String(v ?? '')).replace(/[٬,\s]/g, '').replace(/٫/g, '.');
  const n = parseFloat(s);
  return Number.isFinite(n) ? n : NaN;
}

function formatWithCommas(raw) {
  let s = toLatin(String(raw ?? '')).replace(/[٬,\s]/g, '');
  s = s.replace(/[^\d.]/g, '');
  const parts = s.split('.');
  const int = (parts[0] || '').replace(/\D/g, '');
  const hasDot = parts.length > 1;
  const frac = hasDot ? parts.slice(1).join('').replace(/\D/g, '') : null;
  const intFmt = int ? Number(int).toLocaleString('en-US') : '';
  return frac === null ? intFmt : (intFmt + '.' + frac);
}
function attachAmountFormat(el) {
  if (!el || el._fmtAttached) return;
  el._fmtAttached = true;
  if (el.value) el.value = formatWithCommas(el.value);
  el.addEventListener('input', () => {
    const v = formatWithCommas(el.value);
    if (v !== el.value) el.value = v;
  });
}

function readImageFile(file, cb) {
  const reader = new FileReader();
  reader.onload = e => {
    const img = new Image();
    img.onload = () => {
      const MAX = 900;
      let w = img.width, h = img.height;
      if (w > MAX || h > MAX) { const r = Math.min(MAX / w, MAX / h); w = Math.round(w * r); h = Math.round(h * r); }
      const c = document.createElement('canvas'); c.width = w; c.height = h;
      c.getContext('2d').drawImage(img, 0, 0, w, h);
      cb(c.toDataURL('image/jpeg', 0.72));
    };
    img.onerror = () => cb(null);
    img.src = e.target.result;
  };
  reader.onerror = () => cb(null);
  reader.readAsDataURL(file);
}

const toISO   = d => `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}`;
const todayISO = () => toISO(new Date());
const parseISO = iso => { const [y, m, d] = iso.split('-').map(Number); return new Date(y, m - 1, d); };
const monthKeyOf   = iso => iso.slice(0, 7);
const currentMonthKey = () => todayISO().slice(0, 7);
const daysInMonthOf = key => { const [y, m] = key.split('-').map(Number); return new Date(y, m, 0).getDate(); };
const nowTime = () => toLatin(new Intl.DateTimeFormat('ar', { hour: 'numeric', minute: '2-digit' }).format(new Date()));
const monthLabel = (key, withYear = false) => {
  const d = parseISO(key + '-01');
  return toLatin(new Intl.DateTimeFormat('ar', withYear ? { month:'long', year:'numeric' } : { month:'long' }).format(d));
};
const fmtDate = iso => toLatin(new Intl.DateTimeFormat('ar', { day:'numeric', month:'short' }).format(parseISO(iso)));

function getCats(type){
  return (state.categories && state.categories[type] && state.categories[type].length)
    ? state.categories[type]
    : (type==='income'?CONFIG.incomeCategories:CONFIG.expenseCategories);
}
function categoryById(type,id){
  const list = getCats(type);
  return list.find(c=>c.id===id) || list.find(c=>c.id==='other') || {id:'other',label:'أخرى',icon:'📦',color:'#93a09b'};
}

const personName = id => (state.people.find(p => p.id === +id) || {}).name || '؟';
const fmtMoney   = n => fmtNumber(Math.round((+n || 0) * 100) / 100);
const fmtSigned  = n => `${n < 0 ? '-' : '+'} ${fmtMoney(Math.abs(n))}`;

const StorageAdapter = {
  load() {
    try {
      let data = JSON.parse(localStorage.getItem(CONFIG.storageKey));
      if (!data) {
        data = JSON.parse(localStorage.getItem('daftar-mushtarak:v1'));
        if (data) { data = migrateV1toV2(data); }
      }
      return data;
    } catch { return null; }
  },
  save(data) { try { localStorage.setItem(CONFIG.storageKey, JSON.stringify(data)); } catch {} }
};

function migrateV1toV2(old) {
  if (!old || !old.debts) return old;
  const newDebts = [];
  for (const d of old.debts) {
    const entries = [];
    if (d.total > 0) entries.push({ id: uid(), kind: d.type === 'we_owe' ? 'we_owe' : 'to_us', amount: d.total, date: d.createdAt || todayISO(), note: d.note || 'أصل الدين' });
    for (const a of (d.additions || [])) entries.push({ id: a.id || uid(), kind: d.type === 'we_owe' ? 'we_owe' : 'to_us', amount: a.amount, date: a.date, note: a.note });
    for (const p of (d.payments || [])) entries.push({ id: p.id || uid(), kind: d.type === 'we_owe' ? 'pay_we_owe' : 'pay_to_us', amount: p.amount, date: p.date, note: p.note });
    newDebts.push({ id: d.id || uid(), name: d.name, createdAt: d.createdAt || todayISO(), entries });
  }
  old.debts = newDebts;
  return old;
}

function normalizeDebts() {
  for (const p of (state.debts || [])) {
    for (const e of (p.entries || [])) {
      if (e.kind === 'pay_to_us') e.kind = 'we_owe';
      else if (e.kind === 'pay_we_owe') e.kind = 'to_us';
    }
  }
}

const DB = {
  data: null, _t: null,
  init() { this.data = StorageAdapter.load() || this.defaults(); if (!this.data.people) this.data = this.defaults(); },
  defaults() {
    return { people: [{ id: 1, name: 'أحمد' }, { id: 2, name: 'سارة' }],
      transactions: [], sources: [], goals: [], debts: [], monthGoals: {},
      budget: { ...BUDGET_DEFAULT, tx: [] },
      categories: { expense: CONFIG.expenseCategories.map(c=>({...c})), income: CONFIG.incomeCategories.map(c=>({...c})) },
      settings: { theme: null, currency: '', profitPersonId: 1 } };
  },
  save() { clearTimeout(this._t); this._t = setTimeout(() => StorageAdapter.save(this.data), 120); }
};

let state;

const Repo = {
  insert(col, item) { state[col].push(item); DB.save(); return item; },
  update(col, id, patch) { const it = state[col].find(x => x.id === id); if (it) { Object.assign(it, patch); DB.save(); } return it; },
  remove(col, id) { state[col] = state[col].filter(x => x.id !== id); DB.save(); },
  find(col, id) { return state[col].find(x => x.id === id); }
};

const Stats = {
  totals(list) { const t = { income: 0, expense: 0 }; for (const x of list) x.type === 'income' ? t.income += x.amount : t.expense += x.amount; t.net = t.income - t.expense; return t; },
  inMonth(list, mk) { return list.filter(t => t.date.startsWith(mk)); },
  ofPerson(list, pid) { return list.filter(t => t.personId === +pid); },
  byCategory(list, type) { const m = {}; for (const t of list) { if (t.type !== type) continue; m[t.category] = (m[t.category] || 0) + t.amount; } return m; },
  lastMonthKeys(n) { const now = new Date(), arr = []; for (let i = n - 1; i >= 0; i--) { const d = new Date(now.getFullYear(), now.getMonth() - i, 1); arr.push(`${d.getFullYear()}-${pad(d.getMonth()+1)}`); } return arr; },
  savingsRate(t) { return t.income > 0 ? ((t.income - t.expense) / t.income) * 100 : 0; }
};

const Recurring = {
  generate() {
    const keys = Stats.lastMonthKeys(CONFIG.monthsWindow + 1);
    const today = todayISO();
    const wanted = new Map();
    for (const s of state.sources) {
      if (s.active === false) continue;
      for (const key of keys) {
        const dim = daysInMonthOf(key);
        for (const day of s.days) {
          if (day > dim) continue;
          const iso = `${key}-${pad(day)}`;
          if (iso > today) continue;
          wanted.set(`${s.id}|${iso}`, { s, iso });
        }
      }
    }
    state.transactions = state.transactions.filter(t => !t.sourceId || wanted.has(`${t.sourceId}|${t.date}`));
    const existing = new Set(state.transactions.filter(t => t.sourceId).map(t => `${t.sourceId}|${t.date}`));
    for (const [key, { s, iso }] of wanted) {
      if (existing.has(key)) continue;
      state.transactions.push({ id: uid(), personId: s.personId, type: s.type, category: s.category, amount: s.amount, note: s.label, date: iso, sourceId: s.id, ts: Date.now() });
    }
    DB.save();
  }
};

function toast(msg, type = 'success') {
  const icons = { success: 'check', error: 'alert', info: 'spark' };
  const el = document.createElement('div');
  el.className = `toast ${type}`;
  el.innerHTML = `<svg class="ic"><use href="#i-${icons[type]}"/></svg><span>${msg}</span>`;
  $('#toastRoot').appendChild(el);
  setTimeout(() => { el.classList.add('out'); setTimeout(() => el.remove(), 300); }, 2800);
}

const Modal = {
  root: $('#modalRoot'),
  open(inner) {
    this.root.innerHTML = `<div class="modal-backdrop" data-close></div><div class="modal" role="dialog" aria-modal="true">${inner}</div>`;
    this.root.classList.add('open');
    requestAnimationFrame(() => this.root.classList.add('show'));
    document.body.style.overflow = 'hidden';
  },
  close() {
    if (!this.root.classList.contains('open')) return;
    this.root.classList.remove('show');
    setTimeout(() => { this.root.innerHTML = ''; this.root.classList.remove('open'); }, 260);
    document.body.style.overflow = '';
  }
};

function confirmDialog(message, onOk, iconId) {
  Modal.open(`<div class="confirm-box">
    <span class="big-ic"><svg class="ic" style="width:26px;height:26px"><use href="#${iconId || 'i-trash'}"/></svg></span>
    <h3 style="font-family:'Markazi Text';font-size:1.4rem">تأكيد</h3>
    <p>${message}</p>
    <div class="form-actions"><button class="btn btn-ghost" data-close>إلغاء</button>
    <button class="btn btn-danger" id="confirmOk">تأكيد</button></div></div>`);
  $('#confirmOk').addEventListener('click', () => { onOk(); Modal.close(); });
}

let currentView = 'home';
function showView(name, opts = {}) {
  currentView = name;
  const prevY = window.scrollY;
  $$('.view').forEach(v => v.classList.toggle('is-active', v.id === 'view-' + name));
  $$('.bottom-nav button').forEach(b => b.classList.toggle('active', b.dataset.view === name));
  $('#fab').style.display = (name === 'home') ? 'grid' : 'none';
  ({ home: renderHome, add: renderAdd, debts: renderDebts, budget: renderBudget, recurring: renderRecurring, analytics: renderAnalytics, goals: renderGoals })[name]();
  if (opts.keepScroll) window.scrollTo({ top: prevY });
  else window.scrollTo({ top: 0 });
}
function renderCurrent() { showView(currentView, { keepScroll: true }); }

let recentFilter = 'all', recentSearch = '';
let selectMode = false;
const selectedTx = new Set();
let advState = { text:'', type:'all', person:'all', category:'all', dateFrom:'', dateTo:'', amountMin:'', amountMax:'', sort:'newest', limit:20 };
let budgetFilter = 'all';

function countUp(el, to, fmt) {
  const from = el._v || 0; el._v = to;
  if (Math.abs(to - from) < 0.01) { el.textContent = fmt(to); return; }
  const t0 = performance.now(), dur = 650;
  (function step(t) {
    const p = Math.min(1, (t - t0) / dur), e = 1 - Math.pow(1 - p, 3);
    el.textContent = fmt(from + (to - from) * e);
    if (p < 1) requestAnimationFrame(step);
  })(t0);
}

function netLastDays(n) {
  const out = [], today = new Date();
  for (let i = n - 1; i >= 0; i--) {
    const d = new Date(today); d.setDate(d.getDate() - i);
    out.push(Stats.totals(state.transactions.filter(t => t.date === toISO(d))).net);
  }
  return out;
}

function drawSparkline(cv, vals) {
  if (!cv || !vals.length) return;
  const dpr = devicePixelRatio || 1, w = cv.clientWidth || 300, h = 48;
  cv.width = w * dpr; cv.height = h * dpr;
  const ctx = cv.getContext('2d'); ctx.scale(dpr, dpr); ctx.clearRect(0, 0, w, h);
  const min = Math.min(...vals, 0), max = Math.max(...vals, 1), range = (max - min) || 1;
  const X = i => 4 + i * ((w - 8) / Math.max(1, vals.length - 1));
  const Y = v => h - 5 - ((v - min) / range) * (h - 12);
  ctx.beginPath();
  vals.forEach((v, i) => i ? ctx.lineTo(X(i), Y(v)) : ctx.moveTo(X(i), Y(v)));
  ctx.strokeStyle = '#e2b457'; ctx.lineWidth = 2; ctx.lineJoin = 'round'; ctx.stroke();
  ctx.lineTo(X(vals.length - 1), h); ctx.lineTo(X(0), h); ctx.closePath();
  const g = ctx.createLinearGradient(0, 0, 0, h);
  g.addColorStop(0, 'rgba(226,180,87,.30)'); g.addColorStop(1, 'rgba(226,180,87,0)');
  ctx.fillStyle = g; ctx.fill();
  ctx.beginPath(); ctx.arc(X(vals.length - 1), Y(vals[vals.length - 1]), 3.4, 0, 7);
  ctx.fillStyle = '#fff'; ctx.fill();
}

/* ✅ بطاقة ملخصات مدمجة واحدة مصغّرة */
function pcCol(title, t) {
  return `<div class="pc-col"><span>${title}</span>` +
    `<b class="${t.net >= 0 ? 'in' : 'out'}">${fmtSigned(t.net)}</b>` +
    `<small>↑ ${fmtMoney(t.income)} • ↓ ${fmtMoney(t.expense)}</small></div>`;
}

function personCard(p, monthTxs) {
  const t = Stats.totals(monthTxs);
  const profitPid = getProfitPid();
  const profitLine = (profitPid !== 0 && p.id === profitPid) ? `<div class="profit-line"><svg class="ic"><use href="#i-spark"/></svg>
      <span>الربح المتوقع لـ${escapeHtml(p.name)} (20%)</span><b>${fmtSigned(t.net * CONFIG.partnerProfitRate)}</b></div>` : '';
  return `<article class="card person-card">
    <header class="pc-head"><span class="avatar av-${p.id}">${escapeHtml((p.name || '؟')[0])}</span>
      <div><h3>${escapeHtml(p.name)}</h3><span>مساهمة ${monthLabel(currentMonthKey())}</span></div></header>
