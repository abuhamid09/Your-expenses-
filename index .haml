    <button class="icon-btn" data-close aria-label="إغلاق"><svg class="ic"><use href="#i-close"/></svg></button></div>
    <form id="setForm" class="form-stack">
      <div class="field-row">
        <div class="field"><label>اسم الفرد الأول</label><input id="setName1" value="${escapeHtml(state.people[0].name)}" maxlength="15"></div>
        <div class="field"><label>اسم الفرد الثاني</label><input id="setName2" value="${escapeHtml(state.people[1].name)}" maxlength="15"></div>
      </div>
      <div class="field"><label>الربح 20% يُحسب من</label>
        <select id="setProfitPerson">
          <option value="${state.people[0].id}" ${profitPid === state.people[0].id ? 'selected' : ''}>الربح من الفرد الأول — ${escapeHtml(state.people[0].name)}</option>
          <option value="${state.people[1].id}" ${profitPid === state.people[1].id ? 'selected' : ''}>الربح من الفرد الثاني — ${escapeHtml(state.people[1].name)}</option>
          <option value="0" ${profitPid === 0 ? 'selected' : ''}>بدون — لا الأول ولا الثاني (كلاهما كامل)</option>
        </select></div>
      <div class="field">
        <label>النسخ الاحتياطي — يعمل كله داخل التطبيق</label>
        <div class="backup-actions">
          <button type="button" class="btn btn-ghost" id="exportBtn"><svg class="ic"><use href="#i-up"/></svg> تصدير (نسخ نص)</button>
          <button type="button" class="btn btn-ghost" id="importBtn"><svg class="ic"><use href="#i-down"/></svg> استيراد (لصق نص)</button>
          <button type="button" class="btn btn-ghost" id="snapBtn"><svg class="ic"><use href="#i-save"/></svg> حفظ نسخة داخلية</button>
          <button type="button" class="btn btn-ghost" id="restoreBtn"><svg class="ic"><use href="#i-restore"/></svg> استعادة نسخة داخلية</button>
        </div>
      </div>
      <div class="form-actions"><button class="btn btn-primary" type="submit"><svg class="ic"><use href="#i-check"/></svg> حفظ الإعدادات</button></div>
    </form>`);
  $('#exportBtn').addEventListener('click', openExportModal);
  $('#importBtn').addEventListener('click', openImportPicker);
  $('#snapBtn').addEventListener('click', saveInternalSnapshot);
  $('#restoreBtn').addEventListener('click', restoreInternalSnapshot);
  $('#setForm').addEventListener('submit', e => {
    e.preventDefault();
    state.people[0].name = $('#setName1').value.trim() || state.people[0].name;
    state.people[1].name = $('#setName2').value.trim() || state.people[1].name;
    const v = Number($('#setProfitPerson').value);
    state.settings.profitPersonId = Number.isFinite(v) ? v : 1;
    DB.save(); Modal.close(); toast('تم حفظ الإعدادات ✔');
    renderCurrent();
  });
}

function mulberry32(a) { return function () { a |= 0; a = a + 0x6D2B79F5 | 0; let t = Math.imul(a ^ a >>> 15, 1 | a); t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t; return ((t ^ t >>> 14) >>> 0) / 4294967296; }; }

function seedDemo() {
  const rnd = mulberry32(20260809);
  const keys = Stats.lastMonthKeys(CONFIG.monthsWindow);
  const today = todayISO();
  state.sources = [
    { id: uid(), label: 'راتب أحمد', personId: 1, type: 'income', category: 'salary', amount: 5200, days: [1], active: true },
    { id: uid(), label: 'إيجار الشقة', personId: 1, type: 'expense', category: 'housing', amount: 1800, days: [1], active: true }
  ];
  const push = (pid, type, cat, amount, key, day, note = '') => {
    const dim = daysInMonthOf(key), iso = `${key}-${pad(Math.min(day, dim))}`;
    if (iso > today) return;
    state.transactions.push({ id: uid(), personId: pid, type, category: cat, amount: Math.round(amount), note, date: iso, time: nowTime(), ts: Date.now() });
  };
  keys.forEach((k, i) => {
    push(2, 'income', 'salary', 4700, k, 25, 'راتب سارة');
    push(1, 'income', 'freelance', 900 + rnd() * 1600, k, 10 + Math.floor(rnd() * 8), 'مشروع حر');
    if (i === 1 || i === 3) push(2, 'income', 'gift', 250 + rnd() * 450, k, 14, 'هدية');
    if (i === 2) push(1, 'income', 'invest', 420, k, 20, 'أرباح استثمار');
    const spend = [
      [2,'food',95,5,'بقالة الأسبوع'],[1,'food',62,9,'عشاء خارج البيت'],[2,'food',118,17,'بقالة'],[1,'food',46,22,'قهوة وحلويات'],
      [1,'transport',88,6,'وقود'],[2,'transport',52,15,'تطبيقات توصيل'],
      [2,'bills',214,7,'كهرباء وماء'],[1,'bills',139,8,'إنترنت وجوال'],
      [2,'health',68,12,'صيدلية'],[1,'fun',92,19,'سينما وعشاء'],[2,'fun',57,26,'اشتراكات'],
      [1,'shopping',149,21,'ملابس'],[2,'shopping',81,24,'مستلزمات المنزل'],[1,'education',75,13,'دورة تدريبية']
    ];
    spend.forEach(([pid, cat, base, day, note]) => {
      if (rnd() > (cat === 'education' || cat === 'health' ? 0.55 : 0.12)) push(pid, 'expense', cat, base * (0.75 + rnd() * 0.6), k, day, note);
    });
  });
  const due = new Date(); due.setMonth(due.getMonth() + 5); due.setDate(15);
  state.goals = [{ id: uid(), name: 'شراء لابتوب جديد', targetAmount: 6000, dueDate: toISO(due), initialSaved: 500, auto: false, autoStart: '',
    contributions: [ { id: uid(), amount: 300, date: keys[4] + '-05', personId: 1 }, { id: uid(), amount: 350, date: keys[5] + '-05', personId: 2 } ],
    createdAt: keys[3] + '-01' }];
  state.debts = [
    { id: uid(), name: 'خميس', createdAt: todayISO(), updatedAt: Date.now(), entries: [
      { id: uid(), kind: 'to_us', amount: 500000, date: todayISO(), time: nowTime(), note: 'دين له' },
      { id: uid(), kind: 'we_owe', amount: 100000, date: todayISO(), time: nowTime(), note: 'دين عليه' }
    ]},
    { id: uid(), name: 'أبو خالد', createdAt: todayISO(), entries: [
      { id: uid(), kind: 'to_us', amount: 100000, date: todayISO(), time: nowTime(), note: 'دين أصلي' },
      { id: uid(), kind: 'we_owe', amount: 20000, date: todayISO(), time: nowTime(), note: 'سداد' }
    ]}
  ];
  Recurring.generate(); DB.save();
  toast('تمت تعبئة بيانات تجريبية ✨', 'info');
  renderCurrent();
}

function handleAction(action, ds) {
  const id = ds.id;
  switch (action) {
    case 'go-add': showView('add'); break;
    case 'seed-demo': seedDemo(); break;
    case 'open-adv': openAdvancedSearch(false); break;
    case 'open-adv-all': openAdvancedSearch(true); break;
    case 'adv-more': advState.limit += 20; renderAdvResults(); break;
    case 'adv-clear': {
      advState = { text:'', type:'all', person:'all', category:'all', dateFrom:'', dateTo:'', amountMin:'', amountMax:'', sort:'newest', limit:20 };
      const set = (idv, v) => { const el = $(idv); if (el) el.value = v; };
      set('#advText',''); set('#advType','all'); set('#advPerson','all');
      const catSel = $('#advCat'); if (catSel) { catSel.innerHTML = advCategoryOptions('all'); catSel.value = 'all'; }
      set('#advFrom',''); set('#advTo',''); set('#advMin',''); set('#advMax',''); set('#advSort','newest');
      renderAdvResults();
      break;
    }
    case 'budget-lock': {
      const b = getBudget();
      b.locked = !b.locked; DB.save();
      renderBudget();
      toast(b.locked ? 'تم قفل النسب 🔒' : 'تم فتح النسب للتعديل 🔓');
      break;
    }
    case 'add-budget-tx': openBudgetTxModal(null); break;
    case 'edit-budget-tx': {
      const b = getBudget();
      const t = (b.tx || []).find(x => x.id === id); if (!t) return;
      openBudgetTxModal(t); break;
    }
    case 'del-budget-tx': {
      const b = getBudget();
      const t = (b.tx || []).find(x => x.id === id); if (!t) return;
      const c = BUDGET_CATS.find(x => x.key === t.cat) || BUDGET_CATS[0];
      confirmDialog(`سيتم حذف صرف «${c.label} — ${fmtMoney(t.amount)}» ويتحدث السجل والميزانية فورًا.`, () => {
        b.tx = b.tx.filter(x => x.id !== id);
        DB.save(); toast('تم حذف الصرف وتحديث الميزانية ✔');
        renderBudget();
      });
      break;
    }
    case 'budget-filter': budgetFilter = id; renderBudgetTxList(); break;
    case 'budget-reset': {
      state.budget = { ...state.budget, save: 60, expense: 20, fun: 20 };
      DB.save(); renderBudget(); toast('تمت إعادة النسب إلى 60/20/20 ✔');
      break;
    }
    case 'edit-tx': openTxEditor(Repo.find('transactions', id)); break;
    case 'del-tx': {
      const tx = Repo.find('transactions', id); if (!tx) return;
      if (tx.sourceId) return toast('هذه معاملة مولّدة تلقائيًا — عدّل المصدر الثابت بدلًا منها', 'error');
      confirmDialog(`سيتم حذف معاملة «${categoryById(tx.type, tx.category).label} — ${fmtMoney(tx.amount)}» نهائيًا.`, () => {
        Repo.remove('transactions', id); toast('تم حذف المعاملة'); renderCurrent();
      }); break;
    }
    case 'transfer-tx': {
      const tx = Repo.find('transactions', id); if (!tx) return;
      const other = state.people.find(p => p.id !== tx.personId); if (!other) return;
      tx.personId = other.id; DB.save(); Modal.close();
      toast(`تم النقل إلى ${escapeHtml(other.name)} ✔`);
      renderCurrent();
      break;
    }
    case 'duplicate-tx': {
      const tx = Repo.find('transactions', id); if (!tx) return;
      Repo.insert('transactions', { id: uid(), personId: tx.personId, type: tx.type, category: tx.category, amount: tx.amount, note: tx.note || '', date: todayISO(), time: nowTime(), ts: Date.now() });
      Modal.close(); toast('تم تكرار المعاملة بتاريخ اليوم ✔');
      renderCurrent();
      break;
    }
    case 'start-multi-delete': {
      Modal.close();
      selectMode = true; selectedTx.clear();
      renderRecent();
      toast('حدّد الحركات ثم اضغط «حذف المحدد»', 'info');
      break;
    }
    case 'delete-selected': {
      if (!selectedTx.size) return toast('لم تحدد أي حركة', 'error');
      const n = selectedTx.size;
      confirmDialog(`سيتم حذف ${fmtNumber(n)} حركة نهائيًا.`, () => {
        state.transactions = state.transactions.filter(t => !selectedTx.has(t.id));
        DB.save(); selectedTx.clear(); selectMode = false;
        toast('تم حذف المحدد ✔'); renderHome();
      });
      break;
    }
    case 'cancel-select': { selectMode = false; selectedTx.clear(); renderHome(); break; }
    case 'manage-cats': {
      openCategoryManager(addState.type, () => {
        addState.category = renderCatGrid($('#addCatGrid'), addState.type, addState.category);
      });
      break;
    }
    case 'add-cat': {
      const type = id;
      const icon = (($('#ncIcon') ? $('#ncIcon').value : '') || '').trim() || '🏷️';
      const label = (($('#ncLabel') ? $('#ncLabel').value : '') || '').trim();
      if (!label) return toast('أدخل اسم الفئة', 'error');
      if (!state.categories) state.categories = { expense: CONFIG.expenseCategories.map(c=>({...c})), income: CONFIG.incomeCategories.map(c=>({...c})) };
      if (!state.categories[type]) state.categories[type] = [];
      state.categories[type].push({ id: 'c' + uid(), label, icon, color: '#93a09b' });
      DB.save(); toast('تمت إضافة الفئة ✔');
      openCategoryManager(type, catRefreshCb); if (catRefreshCb) catRefreshCb();
      break;
    }
    case 'edit-cat': openEditCat(ds.type, ds.id); break;
    case 'save-cat': {
      const type = ds.type, cid = ds.id;
      if (!state.categories || !state.categories[type]) return;
      const c = state.categories[type].find(x => x.id === cid); if (!c) return;
      c.label = (($('#ecLabel') ? $('#ecLabel').value : '') || '').trim() || c.label;
      c.icon = (($('#ecIcon') ? $('#ecIcon').value : '') || '').trim() || c.icon;
      DB.save(); toast('تم تحديث الفئة ✔');
      openCategoryManager(type, catRefreshCb); if (catRefreshCb) catRefreshCb();
      break;
    }
    case 'del-cat': {
      const type = ds.type, cid = ds.id;
      confirmDialog('سيتم حذف الفئة. المعاملات القديمة ستظهر تحت «أخرى».', () => {
        state.categories[type] = (state.categories[type] || []).filter(c => c.id !== cid);
        DB.save(); toast('تم حذف الفئة ✔');
        openCategoryManager(type, catRefreshCb); if (catRefreshCb) catRefreshCb();
      });
      break;
    }
    case 'new-debt-person': openNewPersonModal(); break;
    case 'open-person':
      if (lpFired) { lpFired = false; return; }
      selectedPersonId = id; renderDebts(); break;
    case 'close-person': selectedPersonId = null; renderDebts(); break;
    case 'rename-person': { const p = Repo.find('debts', id); if (p) openRenamePersonModal(p); break; }
    case 'delete-person': {
      const p = Repo.find('debts', id); if (!p) return;
      confirmDialog(`سيتم حذف «${escapeHtml(p.name)}» وكل سجل حركاته.`, () => {
        Repo.remove('debts', id);
        selectedPersonId = null;
        toast('تم حذف الشخص ✔'); renderDebts();
      }); break;
    }
    case 'add-debt-entry': {
      const p = Repo.find('debts', id); if (!p) return;
      openEntryEditor(p, null, ds.kind); break;
    }
    case 'edit-entry': {
      const [pid, eid] = id.split('|');
      const p = Repo.find('debts', pid); if (!p) return;
      const entry = (p.entries || []).find(x => x.id === eid); if (!entry) return;
      openEntryEditor(p, entry); break;
    }
    case 'delete-entry': {
      const [pid, eid] = id.split('|');
      const p = Repo.find('debts', pid); if (!p) return;
      const entry = (p.entries || []).find(x => x.id === eid); if (!entry) return;
      const k = DEBT_KINDS[entry.kind] || { label:'حركة' };
      confirmDialog(`سيتم حذف هذه الحركة (${k.label} — ${fmtMoney(entry.amount)}) فقط.`, () => {
        p.entries = (p.entries || []).filter(x => x.id !== eid);
        p.updatedAt = Date.now();
        DB.save(); toast('تم حذف الحركة ✔'); renderDebts();
      }); break;
    }
    case 'view-img': {
      const [pid, eid] = id.split('|');
      const p = Repo.find('debts', pid); if (!p) return;
      const entry = (p.entries || []).find(x => x.id === eid); if (!entry || !entry.img) return;
      Modal.open(`<div class="modal-head"><h3>📷 صورة الإشعار / الفاتورة</h3>
        <button class="icon-btn" data-close aria-label="إغلاق"><svg class="ic"><use href="#i-close"/></svg></button></div>
        <img src="${entry.img}" style="width:100%;border-radius:12px;border:1px solid var(--line)" alt="صورة">
        <div class="form-actions" style="justify-content:center;margin-top:12px">
          <a class="btn btn-ghost" href="${entry.img}" download="daftarna-${eid}.jpg"><svg class="ic"><use href="#i-down"/></svg> تنزيل الصورة</a>
        </div>`);
      break;
    }
    case 'new-source': openSourceEditor(null); break;
    case 'edit-source': openSourceEditor(Repo.find('sources', id)); break;
    case 'del-source': {
      const s = Repo.find('sources', id); if (!s) return;
      confirmDialog(`سيتم حذف مصدر «${escapeHtml(s.label)}» وجميع معاملاته المولّدة.`, () => {
        Repo.remove('sources', id);
        state.transactions = state.transactions.filter(t => t.sourceId !== id); DB.save();
        toast('تم حذف المصدر ومعاملاته'); renderRecurring(); renderHome();
      }); break;
    }
    case 'new-goal': openGoalEditor(null); break;
    case 'edit-goal': openGoalEditor(Repo.find('goals', id)); break;
    case 'del-goal': {
      const g = Repo.find('goals', id); if (!g) return;
      confirmDialog(`سيتم حذف هدف «${escapeHtml(g.name)}» وكل مساهماته.`, () => {
        Repo.remove('goals', id); toast('تم حذف الهدف'); renderGoals();
      }); break;
    }
    case 'add-contrib': openContribModal(Repo.find('goals', id)); break;
    case 'edit-month-goal': {
      const mk = id;
      const start = `${mk}-01`, end = `${mk}-${pad(daysInMonthOf(mk))}`;
      Modal.open(`<div class="modal-head"><h3>هدف شهر ${monthLabel(mk)} — ${fmtNumber(mk.slice(0,4))}</h3>
        <button class="icon-btn" data-close aria-label="إغلاق"><svg class="ic"><use href="#i-close"/></svg></button></div>
        <form id="mgForm" class="form-stack">
          <p class="hint" style="margin:0 0 4px">📅 بداية الهدف: <b>${fmtDate(start)}</b> — نهاية الهدف: <b>${fmtDate(end)}</b></p>
          <div class="field"><label>الهدف المطلوب لهذا الشهر</label>
            <div class="amount-wrap"><input id="mgTarget" inputmode="decimal" value="${(+state.monthGoals[mk] || '')}" placeholder="0"></div></div>
          <div class="form-actions"><button class="btn btn-gold" type="submit"><svg class="ic"><use href="#i-check"/></svg> حفظ الهدف</button></div>
        </form>`);
      attachAmountFormat($('#mgTarget'));
      $('#mgForm').addEventListener('submit', e => {
        e.preventDefault();
        const v = parseAmount($('#mgTarget').value) || 0;
        state.monthGoals[mk] = v; DB.save();
        Modal.close(); toast('تم حفظ هدف الشهر ✔'); renderGoals();
      });
      break;
    }
    case 'filter-person': recentFilter = id === 'all' ? 'all' : +id; renderHome(); break;
  }
}

let lpTimer = null, lpFired = false;
function setupLongPress() {
  document.addEventListener('pointerdown', e => {
    const card = e.target.closest('.person-debt-card');
    if (card) {
      lpFired = false; clearTimeout(lpTimer);
      lpTimer = setTimeout(() => {
        lpFired = true;
        if (navigator.vibrate) navigator.vibrate(30);
        const p = Repo.find('debts', card.dataset.id);
        if (p) openPersonOptions(p);
      }, 500);
      return;
    }
    const txl = e.target.closest('.tx-item');
    if (txl && !selectMode) {
      lpFired = false; clearTimeout(lpTimer);
      const id = txl.dataset.id;
      lpTimer = setTimeout(() => {
        lpFired = true;
        if (navigator.vibrate) navigator.vibrate(30);
        openTxOptions(id);
      }, 500);
      return;
    }
  });
  ['pointerup','pointerleave','pointercancel'].forEach(ev =>
    document.addEventListener(ev, () => clearTimeout(lpTimer), { passive: true }));
  document.addEventListener('scroll', () => clearTimeout(lpTimer), { passive: true, capture: true });
}

function setupBackExit() {
  try { history.replaceState({ daftarna: 1 }, ''); history.pushState({ daftarna: 2 }, ''); } catch (e) {}
  let warned = false;
  window.addEventListener('popstate', () => {
    if (Modal.root.classList.contains('open')) {
      Modal.close();
      try { history.pushState({ daftarna: 1 }, ''); } catch (e) {}
      return;
    }
    if (currentView === 'debts' && selectedPersonId) {
      selectedPersonId = null;
      renderDebts();
      try { history.pushState({ daftarna: 1 }, ''); } catch (e) {}
      return;
    }
    if (!warned) {
      warned = true;
      toast('اضغط مرة أخرى لتسجيل الخروج', 'info');
      setTimeout(() => {
        warned = false;
        try { history.pushState({ daftarna: 1 }, ''); } catch (e) {}
      }, 2000);
    }
  });
}

function wireGlobal() {
  document.addEventListener('click', e => {
    if (selectMode) {
      const item = e.target.closest('.tx-item');
      if (item) {
        const id = item.dataset.id;
        if (selectedTx.has(id)) selectedTx.delete(id); else selectedTx.add(id);
        renderRecent();
        return;
      }
    }
    const act = e.target.closest('[data-action]');
    if (act) { handleAction(act.dataset.action, act.dataset); return; }
    if (e.target.closest('[data-close]')) Modal.close();
  });
  document.addEventListener('keydown', e => { if (e.key === 'Escape') { if (selectMode) { selectMode = false; selectedTx.clear(); renderHome(); } else Modal.close(); } });
  $$('.bottom-nav button').forEach(b => b.addEventListener('click', () => { if (selectMode) { selectMode = false; selectedTx.clear(); } showView(b.dataset.view); }));
  $('#fab').addEventListener('click', () => showView('add'));
  $('#settingsBtn').addEventListener('click', openSettings);
  $('#themeToggle').addEventListener('click', () => applyTheme(document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'));
  $('#recentSearchInput').addEventListener('input', e => { recentSearch = e.target.value; renderRecent(); });
  $('#addPersonPick').addEventListener('click', e => { const b = e.target.closest('[data-pid]'); if (!b) return; addState.personId = +b.dataset.pid; renderAdd(); });
  $('#addTypeSeg').addEventListener('click', e => { const b = e.target.closest('[data-t]'); if (!b) return; addState.type = b.dataset.t; renderAdd(); });
  $('#addCatGrid').addEventListener('change', () => { const c = $('#addCatGrid').querySelector('input:checked'); if (c) addState.category = c.value; });
  $('#addForm').addEventListener('submit', e => {
    e.preventDefault();
    const amount = parseAmount($('#addAmount').value);
    if (!(amount > 0)) return toast('أدخل مبلغًا صحيحًا أكبر من صفر', 'error');
    Repo.insert('transactions', { id: uid(), personId: addState.personId, type: addState.type, amount, category: addState.category, note: $('#addNote').value.trim(), date: $('#addDate').value || todayISO(), time: nowTime(), ts: Date.now() });
    toast(addState.type === 'income' ? 'تم تسجيل الدخل ✔' : 'تم تسجيل المصروف ✔');
    addState.category = getCats(addState.type)[0].id;
    $('#addAmount').value = ''; $('#addNote').value = '';
    renderHome();
  });
  setupLongPress();
  const io = new IntersectionObserver(entries => entries.forEach(en => {
    if (en.isIntersecting) { en.target.classList.add('in'); io.unobserve(en.target); }
  }), { threshold: 0.1 });
  $$('.reveal').forEach(el => io.observe(el));
}

function init() {
  DB.init();
  state = DB.data;
  if (!state.settings) state.settings = { theme: null, currency: '', profitPersonId: 1 };
  if (state.settings.profitPersonId == null || !Number.isFinite(Number(state.settings.profitPersonId))) state.settings.profitPersonId = 1;
  if (!state.debts) state.debts = [];
  if (!state.monthGoals) state.monthGoals = {};
  if (!state.budget) state.budget = { ...BUDGET_DEFAULT, tx: [] };
  if (!state.categories) state.categories = { expense: CONFIG.expenseCategories.map(c=>({...c})), income: CONFIG.incomeCategories.map(c=>({...c})) };
  normalizeDebts();
  Recurring.generate();
  if (window.Chart) Chart.defaults.font.family = "'Tajawal', sans-serif";
  $('#monthPill').textContent = monthLabel(currentMonthKey(), true);
  applyTheme(state.settings.theme || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'), true);
  wireGlobal();
  setupBackExit();
  showView('home');
}

document.addEventListener('DOMContentLoaded', init);
})();
</script>

<script>
if ('serviceWorker' in navigator) {
  window.addEventListener('load', () => {
    navigator.serviceWorker.register('sw.js').catch(() => {});
  });
}
</script>
</body>
</html>