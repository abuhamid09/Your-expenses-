/* ═══ الديون ═══ */
let selectedPersonId = null;

const DEBT_KINDS = {
  to_us:  { label:'🟢 دين له (علينا)', isIncome:true  },
  we_owe: { label:'🔴 دين عليه (لنا)', isIncome:false }
};

function personStats(person) {
  const e = person.entries || [];
  const green = e.filter(x => x.kind === 'to_us').reduce((a, x) => a + x.amount, 0);
  const red   = e.filter(x => x.kind === 'we_owe').reduce((a, x) => a + x.amount, 0);
  const net = green - red;
  const total = green + red;
  const gPct = total > 0 ? (green / total) * 100 : 0;
  const rPct = total > 0 ? 100 - gPct : 0;
  return { green, red, net, total, gPct, rPct };
}

function allPersonsSummary() {
  let toUs = 0, weOwe = 0;
  for (const p of (state.debts || [])) {
    const s = personStats(p);
    if (s.net >= 0) toUs += s.net; else weOwe += -s.net;
  }
  return { toUs, weOwe, net: toUs - weOwe };
}

function tugBarHTML(s, small) {
  return `<div class="tug-bar${small ? ' sm' : ''}">
    <i class="g" style="width:${s.gPct.toFixed(1)}%"></i>
    <i class="r" style="width:${s.rPct.toFixed(1)}%"></i>
  </div>`;
}

function renderDebtsSummary() {
  const sum = allPersonsSummary();
  const totalAll = sum.toUs + sum.weOwe;
  const pctTo  = totalAll > 0 ? (sum.toUs  / totalAll) * 100 : 0;
  const pctWe  = totalAll > 0 ? (sum.weOwe / totalAll) * 100 : 0;
  const pctNet = totalAll > 0 ? (Math.abs(sum.net) / totalAll) * 100 : 0;
  return `<div class="card debt-summary-card">
    <div class="share-row">
      <span class="avatar" style="background:var(--income)">🟢</span>
      <div class="share-info">
        <div class="share-top"><b>مجموع له (علينا)</b><span class="in">${fmtMoney(sum.toUs)}</span></div>
        <div class="share-bar"><i style="width:${pctTo.toFixed(2)}%;background:var(--income)"></i></div>
        <span class="share-pct in">${fmtNumber(+pctTo.toFixed(2))}%</span>
      </div>
    </div>
    <div class="share-row">
      <span class="avatar" style="background:var(--expense)">🔴</span>
      <div class="share-info">
        <div class="share-top"><b>مجموع عليه (لنا)</b><span class="out">${fmtMoney(sum.weOwe)}</span></div>
        <div class="share-bar"><i style="width:${pctWe.toFixed(2)}%;background:var(--expense)"></i></div>
        <span class="share-pct out">${fmtNumber(+pctWe.toFixed(2))}%</span>
      </div>
    </div>
    <div class="share-row">
      <span class="avatar" style="background:var(--gold)">⚖️</span>
      <div class="share-info">
        <div class="share-top"><b>الصافي العام</b><span class="${sum.net >= 0 ? 'in' : 'out'}">${fmtSigned(sum.net)}</span></div>
        <div class="share-bar"><i style="width:${pctNet.toFixed(2)}%;background:${sum.net >= 0 ? 'var(--income)' : 'var(--expense)'}"></i></div>
        <span class="share-pct ${sum.net >= 0 ? 'in' : 'out'}">${fmtNumber(+pctNet.toFixed(2))}%</span>
      </div>
    </div>
  </div>`;
}

function orderedDebts() {
  return (state.debts || []).map((p, i) => ({ p, i }))
    .sort((a, b) => (b.p.updatedAt || 0) - (a.p.updatedAt || 0) || (b.i - a.i))
    .map(x => x.p);
}

function renderDebtsList() {
  const debts = state.debts || [];
  const summary = renderDebtsSummary();
  if (!debts.length) {
    return summary + `<div class="card empty-state"><span class="em">💵</span><h3>لا يوجد أشخاص مسجلون بعد</h3>
      <p>ابدأ بإضافة شخص، ثم اضغط عليه لتسجيل الديون. الأحدث نشاطًا يظهر أعلى.</p></div>`;
  }
  const personsHtml = orderedDebts().map(p => {
    const s = personStats(p);
    const initial = (p.name || '?')[0];
    const netTxt = s.net > 0 ? `له ${fmtMoney(s.net)}` : s.net < 0 ? `عليه ${fmtMoney(-s.net)}` : 'مسدد ✅';
    const netCls = s.net > 0 ? 'in' : s.net < 0 ? 'out' : '';
    return `<article class="card person-debt-card" data-action="open-person" data-id="${p.id}">
      <span class="avatar av-1">${escapeHtml(initial)}</span>
      <div class="pd-info">
        <h3>${escapeHtml(p.name)}</h3>
        <span>🟢 ${fmtMoney(s.green)} • 🔴 ${fmtMoney(s.red)}</span>
        ${tugBarHTML(s, true)}
      </div>
      <div class="pd-side">
        <b class="net ${netCls}">${netTxt}</b>
      </div>
    </article>`;
  }).join('');
  return summary + `<div class="persons-list">${personsHtml}</div>`;
}

/* ✅ بطاقة الشخص بدون اسم داخلي وأصغر */
function renderPersonDetail(person) {
  const s = personStats(person);
  const netAbs = fmtMoney(Math.abs(s.net));
  const netLabel = s.net > 0 ? `له 🟢` : s.net < 0 ? `عليه 🔴` : 'مسدد ✅';
  const netCls = s.net > 0 ? 'in' : s.net < 0 ? 'out' : '';
  const head = `<article class="card person-head-card">
      <div class="net-line ${netCls}">الصافي: ${netAbs} ${netLabel}</div>
      ${tugBarHTML(s, false)}
      <div class="tug-labels">
        <span class="in">🟢 له ${fmtNumber(Math.round(s.gPct))}%</span>
        <span class="out">🔴 عليه ${fmtNumber(Math.round(s.rPct))}%</span>
      </div>
      <div class="person-head-meta">
        <div class="phm-box green"><span>🟢 مجموع له</span><b>${fmtMoney(s.green)}</b></div>
        <div class="phm-box red"><span>🔴 مجموع عليه</span><b>${fmtMoney(s.red)}</b></div>
      </div>
    </article>
    <div class="person-actions-row">
      <button class="btn btn-income" data-action="add-debt-entry" data-id="${person.id}" data-kind="to_us"><svg class="ic"><use href="#i-plus"/></svg> 🟢 دين له</button>
      <button class="btn btn-expense" data-action="add-debt-entry" data-id="${person.id}" data-kind="we_owe"><svg class="ic"><use href="#i-plus"/></svg> 🔴 دين عليه</button>
    </div>`;
  const withIdx = (person.entries || []).map((e, i) => ({ ...e, _i: i }));
  const asc = [...withIdx].sort((a, b) => (a.date || '').localeCompare(b.date || '') || a._i - b._i);
  let run = 0; const rmap = {};
  for (const en of asc) { run += (en.kind === 'to_us' ? en.amount : -en.amount); rmap[en.id] = run; }
  const entries = [...withIdx].sort((a, b) => (b.date || '').localeCompare(a.date || '') || b._i - a._i);
  let historyHtml = '';
  if (entries.length) {
    historyHtml = `<div class="debt-history"><div class="dh-title">📜 سجل الحركات (${fmtNumber(entries.length)}) — الأحدث أعلى</div>` +
      entries.map(e => {
        const k = DEBT_KINDS[e.kind] || { label:'حركة', isIncome:true };
        const runV = rmap[e.id] || 0;
        const pos = runV >= 0;
        return `<div class="dh-row k-${e.kind}">
          <div class="dh-col c-type"><b class="${pos ? 'in' : 'out'}">${pos ? 'له' : 'عليه'}</b></div>
          <div class="dh-col c-amt"><b class="${k.isIncome ? 'in' : 'out'}">${fmtMoney(e.amount)}</b>
            <time>${fmtDate(e.date)}${e.time ? ' • ' + e.time : ''}</time></div>
          <div class="dh-col c-det">${e.img ? `<button class="img-btn" data-action="view-img" data-id="${person.id}|${e.id}" aria-label="صورة" style="border:0;background:none;padding:0"><img src="${e.img}" class="dh-img" alt="صورة"></button>` : ''}
            <span>${escapeHtml(e.note || k.label)}</span></div>
          <div class="dh-col c-bal"><b class="${pos ? 'in' : 'out'}">${runV < 0 ? '-' : ''}${fmtMoney(Math.abs(runV))}</b>
            <div class="dh-actions">
              <button class="icon-btn sm" data-action="edit-entry" data-id="${person.id}|${e.id}" aria-label="تعديل"><svg class="ic"><use href="#i-edit"/></svg></button>
              <button class="icon-btn sm danger" data-action="delete-entry" data-id="${person.id}|${e.id}" aria-label="حذف"><svg class="ic"><use href="#i-trash"/></svg></button>
            </div></div>
        </div>`;
      }).join('') + `</div>`;
  } else {
    historyHtml = `<div class="card empty-state" style="padding:30px 20px">
      <span class="em">📋</span><h3>لا توجد حركات بعد</h3>
      <p>ابدأ بإضافة 🟢 دين له أو 🔴 دين عليه، ويمكن إرفاق صورة إشعار/فاتورة.</p></div>`;
  }
  return head + historyHtml;
}

