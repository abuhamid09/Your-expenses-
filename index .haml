        <div class="goal-meta">
          <div><span>تم ادخاره</span><b class="in">${fmtMoney(s.saved)}</b></div>
          <div><span>الهدف</span><b>${fmtMoney(g.targetAmount)}</b></div>
          <div><span>${lbl1}</span><b class="${s.per1 >= 0 ? 'in' : 'out'}">${fmtMoney(s.per1)}</b></div>
          <div><span>${lbl2}</span><b class="${s.per2 >= 0 ? 'in' : 'out'}">${fmtMoney(s.per2)}</b></div>
          <div><span>المتبقي</span><b class="out">${fmtMoney(s.remaining)}</b></div>
