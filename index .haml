<header class="topbar">
  <div class="brand">
    <span class="brand-badge"><svg class="ic"><use href="#i-wallet"/></svg></span>
    <div><h1>دفترنا</h1><span class="brand-sub">ميزانية مشتركة بين اثنين</span></div>
  </div>
  <div class="topbar-actions">
    <span class="month-pill" id="monthPill"></span>
    <button class="icon-btn" id="themeToggle" aria-label="تبديل الوضع الليلي"><svg class="ic"><use href="#i-moon" id="themeIcon"/></svg></button>
    <button class="icon-btn" id="settingsBtn" aria-label="الإعدادات"><svg class="ic"><use href="#i-gear"/></svg></button>
  </div>
</header>

<main>
  <section id="view-home" class="view is-active">
    <div id="welcomeSlot"></div>
    <div id="heroWrap">
      <div class="hero-card">
        <div class="hero-top"><span class="hero-label">الرصيد المشترك</span><svg class="ic"><use href="#i-wallet"/></svg></div>
        <div class="hero-amount" id="heroBalance">0</div>
        <div class="hero-meta">
          <span class="pill"><span class="dot g"></span> إجمالي الدخل: <b id="heroIncome">0</b></span>
          <span class="pill"><span class="dot r"></span> إجمالي المصروف: <b id="heroExpense">0</b></span>
        </div>
        <canvas id="sparkline" height="48"></canvas>
      </div>
    </div>
    <h2 class="view-title">ملخصات زمنية</h2>
    <div id="periodGrid"></div>
    <h2 class="view-title">مساهمة الشريكين — هذا الشهر</h2>
    <div class="person-grid" id="personGrid"></div>
    <div class="recent-head">
      <h2 class="view-title" style="margin:26px 0 0">آخر الحركات</h2>
      <div class="recent-tools">
        <div class="search-box"><svg class="ic"><use href="#i-search"/></svg>
          <input id="recentSearchInput" placeholder="ابحث في الحركات…" aria-label="بحث"></div>
        <button class="fchip" data-action="open-adv">🔎 بحث متقدم</button>
      </div>
    </div>
    <div id="selectBar"></div>
    <div id="recentFilters" style="display:flex;gap:7px;margin:12px 0;flex-wrap:wrap"></div>
    <ul class="tx-list" id="recentList"></ul>
    <div style="text-align:center;margin-top:12px">
      <button class="btn btn-ghost" data-action="open-adv-all">📋 عرض كل الحركات</button>
    </div>
  </section>

  <section id="view-add" class="view">
    <h2 class="view-title">إضافة معاملة جديدة</h2>
    <form id="addForm" class="card form-stack" autocomplete="off">
      <div class="field"><label>باسم</label><div class="person-pick" id="addPersonPick"></div></div>
      <div class="field"><label>النوع</label>
        <div class="seg" id="addTypeSeg">
          <button type="button" data-t="expense">مصروف ⬇</button>
          <button type="button" data-t="income">دخل ⬆</button>
        </div></div>
      <div class="field"><label>المبلغ</label>
        <div class="amount-wrap"><input id="addAmount" inputmode="decimal" placeholder="0" required></div></div>
      <div class="field"><label style="display:flex;align-items:center;justify-content:space-between">الفئة
