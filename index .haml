      <button class="btn btn-primary" data-action="go-add"><svg class="ic"><use href="#i-plus"/></svg> أضف أول معاملة</button>
      <button class="btn btn-ghost" data-action="seed-demo"><svg class="ic"><use href="#i-spark"/></svg> تعبئة بيانات تجريبية</button>
