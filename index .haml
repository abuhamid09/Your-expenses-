          <button type="button" class="icon-btn sm danger" id="eImgDel" style="display:none" aria-label="إزالة الصورة"><svg class="ic"><use href="#i-trash"/></svg></button>
        </div></div>
      <div class="form-actions">
        <button class="btn btn-primary" type="submit"><svg class="ic"><use href="#i-check"/></svg> ${isNew ? 'إضافة' : 'حفظ'}</button>
      </div>
    </form>`);
  let curKind = e.kind;
  const seg = $('#kindSeg');
  const paintKindSeg = () => {
    seg.querySelectorAll('button').forEach(b => {
      b.className = b.dataset.k === curKind ? ((b.dataset.k === 'to_us') ? 'on-income' : 'on-expense') : '';
    });
  };
  paintKindSeg();
  seg.addEventListener('click', ev => {
    const b = ev.target.closest('[data-k]'); if (!b) return;
    curKind = b.dataset.k; paintKindSeg();
  });
  const prev = $('#eImgPrev'), delBtn = $('#eImgDel');
  const showPrev = () => {
    if (entryImg) { prev.src = entryImg; prev.style.display = 'block'; delBtn.style.display = 'grid'; }
    else { prev.style.display = 'none'; delBtn.style.display = 'none'; }
  };
  showPrev();
  $('#eImg').addEventListener('change', ev => {
    const f = ev.target.files[0]; if (!f) return;
    readImageFile(f, url => { entryImg = url; showPrev(); if (url) toast('تم إرفاق الصورة وضغطها 📷'); });
  });
  delBtn.addEventListener('click', () => { entryImg = null; showPrev(); });
  attachAmountFormat($('#eAmount'));
  $('#entryForm').addEventListener('submit', ev => {
    ev.preventDefault();
    const amount = parseAmount($('#eAmount').value);
    if (!(amount > 0)) return toast('أدخل مبلغًا صحيحًا', 'error');
    const payload = { kind: curKind, amount, date: $('#eDate').value || todayISO(), note: $('#eNote').value.trim(), time: (entry && entry.time) || nowTime(), img: entryImg };
    if (isNew) {
      if (!person.entries) person.entries = [];
      person.entries.push({ id: uid(), ...payload });
    } else {
      Object.assign(entry, payload);
    }
    person.updatedAt = Date.now();
    DB.save(); Modal.close();
    toast(isNew ? 'تمت إضافة الحركة ✔' : 'تم تحديث الحركة ✔');
    renderDebts();
  });
}

