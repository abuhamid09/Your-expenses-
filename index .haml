const addState = { personId: 1, type: 'expense', category: 'food' };

function renderCatGrid(container, type, selected) {
  const cats = getCats(type);
  const sel = cats.some(c => c.id === selected) ? selected : cats[0].id;
  container.innerHTML = cats.map(c => `
    <label class="cat-chip"><input type="radio" name="${container.id}_cat" value="${c.id}" ${c.id === sel ? 'checked' : ''}>
    <span><em>${c.icon}</em>${c.label}</span></label>`).join('');
  return sel;
}

function paintSeg(segEl, type) {
  const [bExp, bInc] = segEl.querySelectorAll('button');
  bExp.className = type === 'expense' ? 'on-expense' : '';
  bInc.className = type === 'income' ? 'on-income' : '';
}

function renderPersonPick(container, selectedId) {
  container.innerHTML = state.people.map(p => `
    <button type="button" class="person-btn ${p.id === selectedId ? 'sel' : ''}" data-pid="${p.id}">
      <span class="avatar av-${p.id}">${escapeHtml((p.name || '؟')[0])}</span>${escapeHtml(p.name)}</button>`).join('');
}

function wireTxForm(root, st) {
  const personPick = $('[data-role="person"]', root);
  const seg = $('[data-role="type"]', root);
  const cats = $('[data-role="cats"]', root);
  const refresh = () => {
    renderPersonPick(personPick, st.personId);
    paintSeg(seg, st.type);
    st.category = renderCatGrid(cats, st.type, st.category);
  };
  refresh();
  personPick.addEventListener('click', e => { const b = e.target.closest('[data-pid]'); if (!b) return; st.personId = +b.dataset.pid; refresh(); });
  seg.addEventListener('click', e => { const b = e.target.closest('[data-t]'); if (!b) return; st.type = b.dataset.t; refresh(); });
  cats.addEventListener('change', () => { const checked = cats.querySelector('input:checked'); if (checked) st.category = checked.value; });
  return refresh;
}

function txFormHTML(tx, p) {
  return `
    <div class="field"><label>باسم</label><div class="person-pick" data-role="person"></div></div>
    <div class="field"><label>النوع</label>
      <div class="seg" data-role="type"><button type="button" data-t="expense">مصروف ⬇</button>
