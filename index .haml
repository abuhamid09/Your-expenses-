}

function txItemHTML(t, i, run, showPerson) {
  const cat = categoryById(t.type, t.category);
  const sel = selectMode && selectedTx.has(t.id);
  const check = selectMode ? `<span class="tx-check">${sel ? '✓' : ''}</span>` : '';
  const actions = selectMode ? '' : (t.sourceId ? '' : `<span class="tx-actions">
        <button class="icon-btn sm" data-action="edit-tx" data-id="${t.id}" aria-label="تعديل"><svg class="ic"><use href="#i-edit"/></svg></button>
        <button class="icon-btn sm danger" data-action="del-tx" data-id="${t.id}" aria-label="حذف"><svg class="ic"><use href="#i-trash"/></svg></button></span>`);
  const personLbl = showPerson ? `${escapeHtml(personName(t.personId))} • ` : '';
  const balLine = (run !== undefined) ? `<span class="bal-lbl ${run >= 0 ? 'in' : 'out'}">الباقي: ${run < 0 ? '-' : ''}${fmtMoney(Math.abs(run))}</span>` : '';
  return `<li class="tx-item ${selectMode ? 'selectable' : ''} ${sel ? 'selected' : ''}" data-id="${t.id}" style="animation-delay:${i * 40}ms">
    ${check}
    <span class="tx-icon" style="background:${cat.color}26">${cat.icon}</span>
    <div class="tx-info">
      <strong>${personLbl}${cat.label}</strong>
      <span>${escapeHtml(t.note || '')}</span>
      <time>${fmtDate(t.date)}${t.time ? ' • ' + t.time : ''}</time></div>
    <div class="tx-side"><b class="${t.type === 'income' ? 'in' : 'out'}">${t.type === 'income' ? '+' : '-'} ${fmtMoney(t.amount)}</b>
      ${balLine}
      ${actions}</div></li>`;
}

function renderSelectBar() {
  const bar = $('#selectBar');
  if (!bar) return;
  if (!selectMode) { bar.style.display = 'none'; bar.innerHTML = ''; return; }
  bar.style.display = 'block';
  bar.innerHTML = `<div class="card select-bar">
     <b>✔ تم تحديد ${fmtNumber(selectedTx.size)}</b>
     <span style="display:flex;gap:6px">
       <button class="btn btn-danger" data-action="delete-selected" style="padding:8px 12px;font-size:.8rem">حذف المحدد</button>
       <button class="btn btn-ghost" data-action="cancel-select" style="padding:8px 12px;font-size:.8rem">إلغاء</button>
     </span></div>`;
}

function renderRecent() {
  const asc = [...state.transactions].sort((a, b) => a.date.localeCompare(b.date) || (a.ts || 0) - (b.ts || 0));
  const runMap = {};
  if (recentFilter === 'all') {
    let run = 0;
    for (const t of asc) { run += (t.type === 'income' ? t.amount : -t.amount); runMap[t.id] = run; }
  } else {
    let run = 0;
    for (const t of asc) { if (t.personId === +recentFilter) { run += (t.type === 'income' ? t.amount : -t.amount); runMap[t.id] = run; } }
  }
  let list = [...state.transactions].sort((a, b) => b.date.localeCompare(a.date) || (b.ts || 0) - (a.ts || 0));
  if (recentFilter !== 'all') list = list.filter(t => t.personId === +recentFilter);
  if (recentSearch.trim()) {
    const q = recentSearch.trim();
    list = list.filter(t => {
      const cat = categoryById(t.type, t.category);
      return cat.label.includes(q) || (t.note || '').includes(q) || personName(t.personId).includes(q);
    });
  }
  const el = $('#recentList');
  el.innerHTML = list.length
    ? list.slice(0, CONFIG.recentLimit).map((t, i) => txItemHTML(t, i, runMap[t.id], true)).join('')
    : `<div class="empty-state"><span class="em">🔎</span><h3>لا توجد حركات مطابقة</h3><p>جرّب تعديل البحث أو التصفية.</p></div>`;
  renderSelectBar();
}

function renderHome() {
