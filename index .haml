function advCategoryOptions(type) {
  let cats = [];
  if (type === 'all') cats = [...getCats('expense'), ...getCats('income')];
  else cats = getCats(type);
  const seen = new Set(); const opts = ['<option value="all">كل الفئات</option>'];
  cats.forEach(c => { if (!seen.has(c.id)) { seen.add(c.id); opts.push(`<option value="${c.id}">${escapeHtml(c.label)}</option>`); } });
  return opts.join('');
}

function computeAdvList() {
  let list = [...state.transactions];
  const a = advState;
  if (a.text.trim()) {
    const q = a.text.trim();
    list = list.filter(t => {
      const cat = categoryById(t.type, t.category);
      return cat.label.includes(q) || (t.note || '').includes(q) || personName(t.personId).includes(q);
    });
  }
  if (a.type !== 'all') list = list.filter(t => t.type === a.type);
  if (a.person !== 'all') list = list.filter(t => t.personId === +a.person);
  if (a.category !== 'all') list = list.filter(t => t.category === a.category);
  if (a.dateFrom) list = list.filter(t => t.date >= a.dateFrom);
  if (a.dateTo) list = list.filter(t => t.date <= a.dateTo);
  const mn = parseAmount(a.amountMin), mx = parseAmount(a.amountMax);
  if (Number.isFinite(mn)) list = list.filter(t => t.amount >= mn);
  if (Number.isFinite(mx)) list = list.filter(t => t.amount <= mx);
  switch (a.sort) {
    case 'oldest': list.sort((x, y) => x.date.localeCompare(y.date) || (x.ts || 0) - (y.ts || 0)); break;
    case 'highest': list.sort((x, y) => y.amount - x.amount); break;
    case 'lowest': list.sort((x, y) => x.amount - y.amount); break;
    default: list.sort((x, y) => y.date.localeCompare(x.date) || (y.ts || 0) - (x.ts || 0));
  }
  return list;
}

function renderAdvResults() {
