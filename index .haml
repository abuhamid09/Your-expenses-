/* ═══ الميزانية ═══ */
function getBudget() {
  if (!state.budget) state.budget = { ...BUDGET_DEFAULT, tx: [] };
  if (!Array.isArray(state.budget.tx)) state.budget.tx = [];
  if (state.budget.locked == null) state.budget.locked = true;
  BUDGET_CATS.forEach(c => { if (state.budget[c.key] == null || !Number.isFinite(+state.budget[c.key])) state.budget[c.key] = BUDGET_DEFAULT[c.key]; });
  if (state.budget.income == null || !Number.isFinite(+state.budget.income)) state.budget.income = 0;
  return state.budget;
}
function budgetSpent(b, key, mk) {
  return (b.tx || []).filter(t => t.cat === key && (t.date || '').startsWith(mk)).reduce((a, t) => a + (+t.amount || 0), 0);
}

function budgetTxItemHTML(t, i) {
  const c = BUDGET_CATS.find(x => x.key === t.cat) || BUDGET_CATS[0];
  return `<li class="tx-item" style="animation-delay:${i * 40}ms">
    <span class="tx-icon" style="background:${c.color}26">${c.icon}</span>
    <div class="tx-info">
      <strong>${c.label}</strong>
      <span>${t.note ? escapeHtml(t.note) : 'صرف من ' + c.label}</span>
      <time>${fmtDate(t.date)}</time></div>
    <div class="tx-side"><b class="out">- ${fmtMoney(t.amount)}</b>
      <span class="tx-actions">
        <button class="icon-btn sm" data-action="edit-budget-tx" data-id="${t.id}" aria-label="تعديل"><svg class="ic"><use href="#i-edit"/></svg></button>
        <button class="icon-btn sm danger" data-action="del-budget-tx" data-id="${t.id}" aria-label="حذف"><svg class="ic"><use href="#i-trash"/></svg></button>
      </span></div></li>`;
}

function renderBudgetTxList() {
  const b = getBudget();
  const mk = currentMonthKey();
  let list = (b.tx || []).filter(t => (t.date || '').startsWith(mk));
  if (budgetFilter !== 'all') list = list.filter(t => t.cat === budgetFilter);
  list.sort((a, b2) => (b2.date || '').localeCompare(a.date || ''));
  const chips = `<button class="fchip ${budgetFilter === 'all' ? 'sel' : ''}" data-action="budget-filter" data-id="all">الكل</button>` +
    BUDGET_CATS.map(c => `<button class="fchip ${budgetFilter === c.key ? 'sel' : ''}" data-action="budget-filter" data-id="${c.key}">${c.icon} ${c.label}</button>`).join('');
  $('#budgetTxList').innerHTML =
    `<div class="dh-title">🧾 سجل صرف هذا الشهر</div>
     <div style="display:flex;gap:7px;flex-wrap:wrap;margin-bottom:10px">${chips}</div>` +
    (list.length
      ? `<ul class="tx-list">${list.map(budgetTxItemHTML).join('')}</ul>`
      : `<div class="empty-state" style="padding:20px"><span class="em">🧾</span><p>لا صرف مسجل في هذا التصنيف هذا الشهر.</p></div>`);
}

function renderBudget() {
  const b = getBudget();
  const mk = currentMonthKey();
  $('#bIncome').value = b.income ? formatWithCommas(b.income) : '';
  $('#budgetTools').innerHTML = `
    <button class="btn btn-ghost" data-action="budget-lock">${b.locked ? '🔒 النسب مقفلة — اضغط للفتح' : '🔓 النسب مفتوحة — اضغط للقفل'}</button>
    <button class="btn btn-primary" data-action="add-budget-tx"><svg class="ic"><use href="#i-plus"/></svg> تسجيل صرف من ميزانية</button>
    <button class="btn btn-ghost" data-action="budget-reset">↺ 60/20/20</button>`;
  $('#budgetCards').innerHTML = BUDGET_CATS.map(c => {
    const pct = +b[c.key] || 0;
    const allocated = (+b.income || 0) * pct / 100;
    const spent = budgetSpent(b, c.key, mk);
    const remaining = Math.max(0, allocated - spent);
    const usedPct = allocated > 0 ? Math.min(100, spent / allocated * 100) : 0;
    const exhausted = allocated > 0 && spent >= allocated;
    return `<div class="card budget-card" style="border-inline-start-color:${c.color}">
      <div class="bc-head"><span>${c.icon} ${c.label} <small style="color:var(--muted)">(${fmtNumber(pct)}%)</small></span>
        <b class="bc-amt" id="amt-${c.key}" style="color:${c.color}">${fmtMoney(allocated)}</b></div>
      <input type="range" min="0" max="100" step="1" value="${pct}" data-bkey="${c.key}" class="bc-slider" ${b.locked ? 'disabled' : ''} aria-label="نسبة ${c.label}">
      <div class="bc-row"><span>النسبة %</span>
        <span><input type="text" inputmode="numeric" data-bnum="${c.key}" value="${pct}" class="bc-num" ${b.locked ? 'disabled' : ''}> %</span></div>
      <div class="bc-spend">
        <div class="bc-spend-row"><span>صرفت:</span><b class="out" id="spent-${c.key}">${fmtMoney(spent)}</b></div>
        <div class="bc-spend-row"><span>الباقي:</span><b id="rem-${c.key}" class="${exhausted ? 'out' : 'in'}">${exhausted ? 'خلصت ✔' : fmtMoney(remaining)}</b></div>
        <div class="share-bar"><i id="bar-${c.key}" style="width:${usedPct.toFixed(1)}%;background:${exhausted ? 'var(--expense)' : c.color}"></i></div>
      </div>
    </div>`;
  }).join('');
  renderBudgetTxList();
  $('#bIncome').addEventListener('input', e => { b.income = parseAmount(e.target.value) || 0; DB.save(); updateBudgetUI(); });
  $$('.bc-slider').forEach(sl => sl.addEventListener('input', e => {
    b[sl.dataset.bkey] = +sl.value;
    const nm = $(`.bc-num[data-bnum="${sl.dataset.bkey}"]`); if (nm) nm.value = sl.value;
    DB.save(); updateBudgetUI();
  }));
  $$('.bc-num').forEach(nm => nm.addEventListener('input', e => {
    const v = Math.max(0, Math.min(100, parseAmount(nm.value) || 0));
    b[nm.dataset.bnum] = v;
    const sl = $(`.bc-slider[data-bkey="${nm.dataset.bnum}"]`); if (sl) sl.value = v;
    DB.save(); updateBudgetUI();
  }));
  updateBudgetUI();
}

function updateBudgetUI() {
  const b = getBudget();
  const mk = currentMonthKey();
  const income = +b.income || 0;
  BUDGET_CATS.forEach(c => {
    const pct = +b[c.key] || 0;
    const allocated = income * pct / 100;
    const spent = budgetSpent(b, c.key, mk);
    const remaining = Math.max(0, allocated - spent);
    const usedPct = allocated > 0 ? Math.min(100, spent / allocated * 100) : 0;
    const exhausted = allocated > 0 && spent >= allocated;
    const am = $('#amt-' + c.key); if (am) am.textContent = fmtMoney(allocated);
    const sp = $('#spent-' + c.key); if (sp) sp.textContent = fmtMoney(spent);
    const rm = $('#rem-' + c.key); if (rm) { rm.textContent = exhausted ? 'خلصت ✔' : fmtMoney(remaining); rm.className = exhausted ? 'out' : 'in'; }
    const bar = $('#bar-' + c.key); if (bar) { bar.style.width = usedPct.toFixed(1) + '%'; bar.style.background = exhausted ? 'var(--expense)' : c.color; }
  });
  const total = BUDGET_CATS.reduce((a, c) => a + (+b[c.key] || 0), 0);
  const dc = $('#donutTotal'); if (dc) dc.textContent = fmtNumber(total) + '%';
  renderBudgetDonut();
  renderBudgetDaily();
}

function renderBudgetDonut() {
  const b = getBudget();
  Charts.make('budgetDonut', { type: 'doughnut',
    data: { labels: BUDGET_CATS.map(c => c.label), datasets: [{ data: BUDGET_CATS.map(c => +b[c.key] || 0), backgroundColor: BUDGET_CATS.map(c => c.color), borderWidth: 2, borderColor: Charts.cssVar('--surface') }] },
    options: { responsive: true, maintainAspectRatio: false, cutout: '62%',
      plugins: { legend: { position: 'bottom', rtl: true, labels: { color: Charts.cssVar('--muted'), usePointStyle: true, pointStyle: 'circle', font: { family: "'Tajawal'", size: 11 } } },
        tooltip: { rtl: true, callbacks: { label: c => ` ${c.label}: ${fmtNumber(c.parsed)}%` } } } } });
}

function renderBudgetDaily() {
  const b = getBudget();
  const income = +b.income || 0;
  const mk = currentMonthKey();
  const dim = daysInMonthOf(mk);
  const plannedDaily = income * ((+b.expense || 0) + (+b.fun || 0)) / 100 / dim;
  const actual = Array(dim).fill(0);
  for (const t of (b.tx || [])) {
    if ((t.cat === 'expense' || t.cat === 'fun') && (t.date || '').startsWith(mk)) actual[+t.date.slice(8) - 1] += (+t.amount || 0);
  }
  Charts.make('budgetDaily', { type: 'bar',
    data: { labels: Array.from({ length: dim }, (_, i) => fmtNumber(i + 1)), datasets: [
      { type: 'line', label: 'المخطّط يوميًا', data: Array(dim).fill(plannedDaily), borderColor: '#e2b457', borderWidth: 2, pointRadius: 0, fill: false },
      { type: 'bar', label: 'الفعلي', data: actual, backgroundColor: 'rgba(226,112,143,.85)', borderRadius: 4, maxBarThickness: 12 } ] },
    options: { responsive: true, maintainAspectRatio: false,
      plugins: { legend: { rtl: true, labels: { color: Charts.cssVar('--muted'), usePointStyle: true, pointStyle: 'circle', font: { family: "'Tajawal'", size: 11 } } },
        tooltip: { rtl: true, callbacks: { label: c => ` ${c.dataset.label}: ${fmtMoney(c.parsed.y)}` } } },
      scales: { x: { ticks: { color: Charts.cssVar('--muted'), font: { size: 10 }, maxTicksLimit: 12 }, grid: { display: false } },
                y: { ticks: { color: Charts.cssVar('--muted'), font: { size: 10 } }, grid: { color: Charts.cssVar('--chart-grid') }, beginAtZero: true } } } });
}

